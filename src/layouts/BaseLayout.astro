---
import { Font } from 'astro:assets'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { alternatesFor, defaultLang, isLang, languages, type Lang } from '../i18n/ui'

interface Props {
  title: string
  description?: string
  /** URL of this page in each language. Defaults to the matching fixed route. */
  alternates?: Record<Lang, string>
}

const { title, description, alternates = alternatesFor(Astro.url.pathname) } = Astro.props
const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang
const langs = Object.keys(languages) as Lang[]
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {langs.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(alternates[code], Astro.site)} />
    ))}
    <Font cssVariable="--font-inter-tight" preload />
  </head>
  <body>
    <Header lang={lang} alternates={alternates} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
