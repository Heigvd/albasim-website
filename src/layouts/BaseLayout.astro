---
import { Font } from 'astro:assets'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { alternatesFor, defaultLang, isLang, languages, type Lang } from '../i18n/ui'

interface Props {
  title: string
  description?: string
  /** URL of this page in each language. Defaults to the matching fixed route. */
  alternates?: Record<Lang, string>
  /** Asks search engines not to index the page. */
  noindex?: boolean
}

const {
  title,
  description,
  alternates = alternatesFor(Astro.url.pathname),
  noindex = false,
} = Astro.props
const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang
const langs = Object.keys(languages) as Lang[]
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- The AlbaSim mark: ink on light tabs, white on dark ones (favicon.svg); favicon.ico for
         browsers without SVG favicons; a white tile for the home screen of Apple devices. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex &&
      langs.map((code) => (
        <link rel="alternate" hreflang={code} href={new URL(alternates[code], Astro.site)} />
      ))}
    <Font cssVariable="--font-inter-tight" preload />
  </head>
  <body>
    <Header lang={lang} alternates={alternates} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
