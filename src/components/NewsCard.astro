---
// News card: image, month, title and "Read more".
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Card from './Card.astro'
import CardAction from './CardAction.astro'
import { useTranslations, type Lang } from '../i18n/ui'

interface Props {
  href: string
  title: string
  date: Date
  image: ImageMetadata
  imageAlt: string
  lang: Lang
  class?: string
}

const { href, title, date, image, imageAlt, lang, class: className, ...attrs } = Astro.props
const t = useTranslations(lang)
const month = new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric', timeZone: 'UTC' })
---

<Card {...attrs} href={href} class:list={['news-card', className]}>
  <Image
    slot="media"
    src={image}
    alt={imageAlt}
    widths={[400, 800]}
    sizes="(max-width: 820px) 100vw, 400px"
    class="image"
  />
  <div class="body">
    <time class="t-tag" datetime={date.toISOString().slice(0, 10)}>
      {month.format(date)}
    </time>
    <h3 class="title t-card">{title}</h3>
    <CardAction class="action">{t('card.readMore')}</CardAction>
  </div>
</Card>

<style>
  .image {
    aspect-ratio: 3 / 2;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 24px 24px 22px;
  }

  .title {
    margin: 12px 0 28px;
  }

  .action {
    margin-top: auto;
    padding-bottom: 14px;
    border-bottom: 1px solid currentColor;
  }
</style>
