export type IconName = keyof typeof paths

interface Props {
  name: IconName
  width?: number
  height?: number
  strokeWidth?: number
  class?: string
}

// `attrs` forwards the parent's scope attribute, so its scoped styles reach the icon.
const {
  name,
  width = 16,
  height = width,
  strokeWidth = 1.8,
  class: className,
  ...attrs
} = Astro.props
const icon = paths[name]
---

<svg
  {...attrs}
  aria-hidden="true"
  class={className}
  width={width}
  height={height}
  viewBox={icon.viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {icon.d.map((d) => (
    <path d={d} />
  ))}
</svg>
