---
// Stroke icons from the design. They take the text color and are hidden from screen readers:
// the text next to them carries the meaning.

const paths = {
  // Long arrow of buttons
  'arrow-long': { viewBox: '0 0 44 20', d: ['M2 10h38', 'M32 3l8 7-8 7'] },
  // Short arrow of text links
  arrow: { viewBox: '0 0 22 16', d: ['M1 8h19', 'M14 2l6 6-6 6'] },
  'arrow-down': { viewBox: '0 0 16 22', d: ['M8 1v19', 'M2 14l6 6 6-6'] },
  external: {
    viewBox: '0 0 20 20',
    d: ['M11 3h6v6', 'M17 3l-8 8', 'M15 12v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4'],
  },
  login: {
    viewBox: '0 0 24 24',
    d: [
      'M9 8V6a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-2',
      'M3 12h13',
      'M13 9l3 3-3 3',
    ],
  },
  menu: { viewBox: '0 0 24 24', d: ['M4 7h16', 'M4 12h16', 'M4 17h16'] },
  close: { viewBox: '0 0 24 24', d: ['M6 6l12 12', 'M18 6L6 18'] },
  chevron: { viewBox: '0 0 24 24', d: ['M6 9l6 6 6-6'] },
  leaf: {
    viewBox: '0 0 24 24',
    d: ['M5 19c9 0 14-6 14-15-8 0-14 4-14 12 0 1 0 2 .5 3', 'M5 19c2-4 5-7 9-9'],
  },
} as const

export type IconName = keyof typeof paths

interface Props {
  name: IconName
  width?: number
  height?: number
  strokeWidth?: number
  class?: string
}

// `attrs` forwards the parent's scope attribute, so its scoped styles reach the icon.
const {
  name,
  width = 16,
  height = width,
  strokeWidth = 1.8,
  class: className,
  ...attrs
} = Astro.props
const icon = paths[name]
---

<svg
  {...attrs}
  aria-hidden="true"
  class={className}
  width={width}
  height={height}
  viewBox={icon.viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {icon.d.map((d) => (
    <path d={d} />
  ))}
</svg>
