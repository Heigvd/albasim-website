---
// Stroke icons from the design. They take the text color and are hidden from screen readers:
// the text next to them carries the meaning.

const paths = {
  // Long arrow of buttons
  'arrow-long': { viewBox: '0 0 44 20', d: ['M2 10h38', 'M32 3l8 7-8 7'] },
  // Short arrow of text links
  arrow: { viewBox: '0 0 22 16', d: ['M1 8h19', 'M14 2l6 6-6 6'] },
  'arrow-down': { viewBox: '0 0 16 22', d: ['M8 1v19', 'M2 14l6 6 6-6'] },
  external: {
    viewBox: '0 0 20 20',
    d: ['M11 3h6v6', 'M17 3l-8 8', 'M15 12v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4'],
  },
  login: {
    viewBox: '0 0 24 24',
    d: [
      'M9 8V6a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-2',
      'M3 12h13',
      'M13 9l3 3-3 3',
    ],
  },
  chevron: { viewBox: '0 0 24 24', d: ['M6 9l6 6 6-6'] },
  leaf: {
    viewBox: '0 0 24 24',
    d: ['M5 19c9 0 14-6 14-15-8 0-14 4-14 12 0 1 0 2 .5 3', 'M5 19c2-4 5-7 9-9'],
  },
  // Chevron of the research questions
  'chevron-right': { viewBox: '0 0 24 24', d: ['M9 5l7 7-7 7'] },
  github: {
    viewBox: '0 0 24 24',
    d: [
      'M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21',
    ],
  },
  // Application domains of the research page
  cross: { viewBox: '0 0 24 24', d: ['M12 5v14M5 12h14'] },
  lines: { viewBox: '0 0 24 24', d: ['M4 7h9M7 12h11M10 17h7'] },
  code: { viewBox: '0 0 24 24', d: ['M9 7l-5 5 5 5M15 7l5 5-5 5'] },
  sprout: {
    viewBox: '0 0 24 24',
    d: ['M6 18c10 0 13-7 13-13-8 0-13 4-13 11 0 1 0 1 0 2', 'M6 18c2-4 5-7 9-9'],
  },
  magnifier: {
    viewBox: '0 0 24 24',
    d: ['M16.5 10.5a6 6 0 1 1-12 0 6 6 0 0 1 12 0z', 'M15 15l5 5'],
  },
  bolt: { viewBox: '0 0 24 24', d: ['M13 3L5 14h6l-1 7 8-11h-6l1-7z'] },
} as const

export type IconName = keyof typeof paths

interface Props {
  name: IconName
  width?: number
  height?: number
  strokeWidth?: number
  class?: string
}

// `attrs` forwards the parent's scope attribute, so its scoped styles reach the icon.
const {
  name,
  width = 16,
  height = width,
  strokeWidth = 1.8,
  class: className,
  ...attrs
} = Astro.props
const icon = paths[name]
---

<svg
  {...attrs}
  aria-hidden="true"
  class={className}
  width={width}
  height={height}
  viewBox={icon.viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {icon.d.map((d) => (
    <path d={d} />
  ))}
</svg>
