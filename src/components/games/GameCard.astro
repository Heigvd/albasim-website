---
// Card of a ready-to-use game: a photo on one side and, on the other, the field and languages of
// the game, its name, a summary, two highlights, how to get it and "Learn more". The whole card
// links to the game's page. In a list, every other card has its photo on the right.
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import CardAction from '../CardAction.astro'
import { gamePath, useTranslations, type Lang } from '../../i18n/ui'
import { languagesLabel as describeLanguages } from '../../utils/games'

interface Props {
  game: CollectionEntry<'games'>
  lang: Lang
}

const { game, lang } = Astro.props
const t = useTranslations(lang)
const data = game.data
const href = gamePath(game.id.split('/').pop() ?? game.id, lang)
const languagesLabel = describeLanguages(data.languages, lang)
---

<a href={href} class="game-card">
  <div class="media">
    <Image
      src={data.image}
      alt={data.imageAlt}
      widths={[600, 1200]}
      sizes="(max-width: 820px) 100vw, 600px"
      class="image"
    />
  </div>
  <div class="body">
    <div>
      <p class="domain">
        {data.domain}
        <span class="languages" title={languagesLabel}>
          <span class="sr-only">{languagesLabel}</span>
          {data.languages.map((code) => (
            <span class="language" aria-hidden="true">
              {code.toUpperCase()}
            </span>
          ))}
        </span>
      </p>
      <h3 class="name">{data.name}</h3>
    </div>
    <p class="summary">{data.summary}</p>
    <ul class="highlights">
      {data.highlights.map((item) => (
        <li>
          <span class="highlight-title">{item.title}</span>
          <span class="highlight-text">{item.text}</span>
        </li>
      ))}
    </ul>
    <p class="access">{data.access}</p>
    <CardAction size="large" class="action">
      {t('card.learnMore')}
    </CardAction>
  </div>
</a>

<style>
  .game-card {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    background: var(--color-white);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    transition: border-color var(--duration-base) ease-out;
  }

  .game-card:hover {
    color: var(--color-ink);
  }

  /* 2 px red frame drawn inside the border on hover, as on the other cards */
  .game-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: 4;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px var(--color-primary);
    opacity: 0;
    transition: opacity var(--duration-base) ease-out;
    pointer-events: none;
  }

  .game-card:hover,
  .game-card:focus-visible {
    border-color: var(--color-primary);
  }

  .game-card:hover::after,
  .game-card:focus-visible::after {
    opacity: 1;
  }

  .game-card:focus-visible {
    outline-offset: 4px;
  }

  .media {
    position: relative;
    min-height: 340px;
    background: var(--color-tint);
  }

  /* Every other card has its photo on the right. */
  :global(li:nth-child(even)) > .game-card .media {
    order: 2;
  }

  .image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 36px 40px 30px;
  }

  .domain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 8px;
    color: var(--color-text-muted);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .languages {
    display: inline-flex;
    gap: 4px;
  }

  .language {
    padding: 1px 7px;
    border: 1px solid var(--color-separator);
    border-radius: var(--radius-pill);
    font-size: 12px;
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  .name {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .summary {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
  }

  /* The two highlights side by side, under a rule, with a rule between them */
  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .highlights li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 15px;
  }

  .highlights li:first-child {
    padding-right: 20px;
  }

  .highlights li:last-child {
    padding-left: 20px;
    border-left: 1px solid var(--color-line);
  }

  .highlight-title {
    font-weight: 600;
  }

  .highlight-text {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .access {
    margin: auto 0 10px;
    padding-top: 16px;
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .action {
    padding-bottom: 12px;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 820px) {
    .game-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .media {
      min-height: 220px;
    }

    :global(li:nth-child(even)) > .game-card .media {
      order: 0;
    }

    .highlights {
      grid-template-columns: minmax(0, 1fr);
    }

    .highlights li:first-child {
      padding-right: 0;
    }

    .highlights li:last-child {
      padding: 14px 0 0;
      border-left: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-card,
    .game-card::after {
      transition: none;
    }
  }
</style>
