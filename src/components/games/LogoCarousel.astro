---
// A row of logos that scrolls sideways, with buttons to go back and forth. At either end, the
// buttons jump to the other end.
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Icon from '../Icon.astro'
import { useTranslations, type Lang } from '../../i18n/ui'

interface Props {
  heading: string
  items: { name: string; logo: ImageMetadata; height: number }[]
  lang: Lang
}

const { heading, items, lang } = Astro.props
const t = useTranslations(lang)
---

<section aria-labelledby="users-heading">
  <div class="container inner">
    <h2 id="users-heading" class="t-h2 heading">
      {heading}
    </h2>
    <div class="carousel" data-carousel>
      <button type="button" class="control" data-carousel-previous>
        <Icon name="arrow-left" width={22} strokeWidth={2} />
        <span class="sr-only">{t('carousel.previous')}</span>
      </button>
      <ul class="track" data-carousel-track tabindex="0" aria-label={heading}>
        {items.map((item) => (
          <li>
            <Image
              src={item.logo}
              alt={item.name}
              height={item.height}
              densities={[1, 2]}
              class="logo"
              style={{ height: `${item.height}px` }}
            />
          </li>
        ))}
      </ul>
      <button type="button" class="control" data-carousel-next>
        <Icon name="arrow-right" width={22} strokeWidth={2} />
        <span class="sr-only">{t('carousel.next')}</span>
      </button>
    </div>
  </div>
</section>

<style>
  .inner {
    padding-block: 32px 88px;
  }

  .heading {
    margin: 0 0 32px;
  }

  .carousel {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .track {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 56px;
    min-width: 0;
    margin: 0;
    padding: 0 22% 0 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track li {
    flex: 0 0 auto;
  }

  /* The height is set on each logo, so that the row keeps its length before the images load. */
  .logo {
    display: block;
    width: auto;
    max-width: none;
  }

  .control {
    display: flex;
    flex: 0 0 48px;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .control:hover {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-white);
  }

  @media (max-width: 680px) {
    .carousel {
      gap: 12px;
    }

    .control {
      flex-basis: 40px;
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .control {
      transition: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  for (const carousel of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]')
    if (!track) continue
    const scroll = (left: number) =>
      track.scrollTo({ left, behavior: reducedMotion.matches ? 'auto' : 'smooth' })

    carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4
      scroll(atEnd ? 0 : track.scrollLeft + track.clientWidth * 0.6)
    })
    carousel.querySelector('[data-carousel-previous]')?.addEventListener('click', () => {
      const atStart = track.scrollLeft <= 4
      scroll(atStart ? track.scrollWidth : Math.max(0, track.scrollLeft - track.clientWidth * 0.6))
    })
  }
</script>
