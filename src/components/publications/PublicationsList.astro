---
// All the publications, grouped by year (newest first), with filter buttons by type that stay
// under the header while scrolling. Within a year, publications follow the order of the types,
// then the alphabetical order of their titles. The filters need JavaScript: without it they stay
// hidden and the whole list shows.
import type { CollectionEntry } from 'astro:content'
import PublicationCard from '../PublicationCard.astro'
import { publicationTypes } from '../../content.config'
import { useTranslations, type Lang } from '../../i18n/ui'
import { publicationCardProps } from '../../utils/publications'

interface Props {
  publications: CollectionEntry<'publications'>[]
  lang: Lang
}

const { publications, lang } = Astro.props
const t = useTranslations(lang)

const typeOrder = (entry: CollectionEntry<'publications'>) =>
  publicationTypes.indexOf(entry.data.type)
const sorted = [...publications].sort(
  (a, b) =>
    b.data.year - a.data.year ||
    typeOrder(a) - typeOrder(b) ||
    a.data.title.localeCompare(b.data.title, a.data.lang),
)
const years = [...new Set(sorted.map((entry) => entry.data.year))].map((year) => ({
  year,
  entries: sorted.filter((entry) => entry.data.year === year),
}))

const filters = [
  { key: 'all', label: t('publications.filter.all'), count: publications.length },
  ...publicationTypes.map((type) => ({
    key: type,
    label: t(`publications.filter.${type}`),
    count: publications.filter((entry) => entry.data.type === type).length,
  })),
]
---

<div class="container inner" data-publications data-shown-label={t('publications.shown')}>
  <div class="filters" role="group" aria-label={t('publications.filterLabel')} hidden>
    {filters.map((filter) => (
      <button
        type="button"
        class:list={['chip', filter.key]}
        aria-pressed={filter.key === 'all' ? 'true' : 'false'}
        data-filter={filter.key}
      >
        {filter.label}
        <span class="count">{filter.count}</span>
      </button>
    ))}
  </div>
  <p class="sr-only" aria-live="polite" data-status></p>

  <div class="years">
    {years.map(({ year, entries }) => (
      <section class="year-group" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="year">
          {year}
        </h2>
        <ul class="grid">
          {entries.map((entry) => (
            <li data-type={entry.data.type}>
              <PublicationCard {...publicationCardProps(entry)} hideYear lang={lang} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</div>

<style>
  .inner {
    padding-block: 18px 120px;
  }

  /* Filter buttons, kept under the compact header while scrolling */
  .filters {
    position: sticky;
    top: var(--header-compact-height);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 calc(-1 * var(--gutter)) 40px;
    padding: 14px var(--gutter);
    background: rgb(255 255 255 / 96%);
  }

  .filters[hidden] {
    display: none;
  }

  /* Each type has its color: pale when off, full when on. "All" is white, ink when on. */
  .chip {
    --chip: var(--color-white);
    --chip-off: var(--color-white);
    --chip-border: var(--color-separator);
    --chip-selected: var(--color-ink);

    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 15px;
    border: 2px solid var(--chip-border);
    border-radius: var(--radius-pill);
    background: var(--chip-off);
    color: var(--color-ink);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .chip.journal-article {
    --chip: var(--color-lavender);
    --chip-strong: var(--color-lavender-strong);
  }

  .chip.book-chapter {
    --chip: var(--color-peach);
    --chip-strong: var(--color-peach-strong);
  }

  .chip.conference-paper {
    --chip: var(--color-turquoise);
    --chip-strong: var(--color-turquoise-strong);
  }

  .chip.other {
    --chip: var(--color-sage);
    --chip-strong: var(--color-sage-strong);
  }

  .chip:not(.all) {
    --chip-off: color-mix(in srgb, var(--chip) 25%, var(--color-white));
    --chip-border: var(--chip);
    --chip-selected: color-mix(in srgb, var(--chip-strong) 65%, var(--color-ink));
  }

  .chip:hover {
    border-color: var(--chip-selected);
  }

  .chip[aria-pressed='true'] {
    border-color: var(--chip-selected);
    background: var(--chip);
  }

  .chip.all[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .count {
    font-size: 13px;
    opacity: 0.7;
  }

  /* Years */
  .years {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  .year-group[hidden] {
    display: none;
  }

  .year {
    margin: 0 0 24px;
    padding-top: 16px;
    border-top: 2px solid var(--color-ink);
    font-size: clamp(30px, 3.6vw, 40px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: flex;
  }

  .grid > li > :global(*) {
    flex: 1;
  }

  .grid > li[hidden] {
    display: none;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Small screens: the filters stay on one row that scrolls sideways, so that the sticky bar
     stays thin. The right edge fades out to show that more buttons follow. */
  @media (max-width: 680px) {
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(to right, black calc(100% - 32px), transparent);
    }

    .filters::-webkit-scrollbar {
      display: none;
    }

    .chip {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    /* Room after the last button, so that it can scroll out of the fade. */
    .chip:last-child {
      margin-right: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-publications]')) {
    const filters = root.querySelector<HTMLElement>('.filters')
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')]
    const items = [...root.querySelectorAll<HTMLElement>('li[data-type]')]
    const groups = [...root.querySelectorAll<HTMLElement>('.year-group')]
    const status = root.querySelector<HTMLElement>('[data-status]')
    const shownLabel = root.dataset.shownLabel ?? '{count}'

    const apply = (filter: string) => {
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter))
      }
      let shown = 0
      for (const item of items) {
        const visible = filter === 'all' || item.dataset.type === filter
        item.hidden = !visible
        if (visible) shown++
      }
      // Hide the years left without any publication.
      for (const group of groups) {
        group.hidden = !group.querySelector('li:not([hidden])')
      }
      if (status) status.textContent = shownLabel.replace('{count}', String(shown))
    }

    for (const button of buttons) {
      button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'))
    }
    if (filters) filters.hidden = false
  }
</script>
