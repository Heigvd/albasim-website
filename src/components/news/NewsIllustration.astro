---
// Illustration of the news page hero: a newspaper with pixel squares rising from its corner.
// When it comes into view, the headline and the picture appear, the lines of text write
// themselves and the squares bob; the squares rise and the lines stretch under the mouse
// pointer. With reduced motion, it stays still. The animation is shared: see
// src/scripts/illustrations.ts.

interface Props {
  /** Description for screen readers. */
  label: string
  class?: string
}

const { label, class: className, ...attrs } = Astro.props

// Lines of text on the page, written from the bottom up: [x1, y, x2, delay in s].
const lines = [
  [176, 128, 234, 1.8],
  [176, 140, 234, 1.5],
  [176, 152, 222, 1.2],
  [176, 164, 230, 0.9],
  [116, 180, 234, 0.6],
  [116, 192, 200, 0.3],
] as const
// Squares rising from the corner, in the order they bob: [x, y, size, fill].
const squares = [
  [234, 62, 16, 'primary'],
  [257.5, 49.5, 13, 'ink'],
  [226, 36, 16, 'outline'],
  [262, 22, 16, 'primary'],
  [240.5, 12.5, 13, 'ink'],
] as const
---

<svg
  {...attrs}
  class:list={['news-illustration', className]}
  viewBox="0 0 320 230"
  role="img"
  aria-label={label}
  data-illustration
  data-duration="2200"
>
  <!-- A dark page behind the newspaper -->
  <rect x="78" y="70" width="150" height="130" rx="6" class="ink"></rect>

  <!-- The newspaper: headline, picture and lines of text -->
  <rect x="100" y="88" width="150" height="120" rx="6" class="outline page"></rect>
  <rect
    x="116"
    y="104"
    width="90"
    height="10"
    class="primary rise"
    style="animation-delay: 0.1s"
  ></rect>
  <rect
    x="116"
    y="124"
    width="50"
    height="42"
    class="soft rise"
    style="animation-delay: 0.25s"
  ></rect>
  <g class="text-lines">
    {lines.map(([x1, y, x2, delay]) => (
      <line
        x1={x1}
        y1={y}
        x2={x2}
        y2={y}
        pathLength="1"
        class="write"
        style={`animation-delay: ${delay}s`}
      />
    ))}
  </g>

  <!-- Squares rising from the corner -->
  {squares.map(([x, y, size, fill], i) => (
    <rect
      x={x}
      y={y}
      width={size}
      height={size}
      class:list={['square', 'wiggle', fill]}
      style={`animation-delay: ${(i * 0.12).toFixed(2)}s`}
    />
  ))}
</svg>

<style>
  .news-illustration {
    display: block;
    width: 100%;
    max-width: 460px;
    height: auto;
    aspect-ratio: 4 / 3;
    margin-left: auto;
  }

  .ink {
    fill: var(--color-ink);
  }

  .primary {
    fill: var(--color-primary);
  }

  .soft {
    fill: var(--color-primary-soft);
  }

  .outline {
    fill: var(--color-white);
    stroke: var(--color-ink);
  }

  .page {
    stroke-width: 1.5;
  }

  .text-lines {
    stroke: var(--color-primary-soft);
    stroke-width: 3;
  }
</style>

<script>
  import '../../scripts/illustrations'
</script>
