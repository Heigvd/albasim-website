---
// Clickable card from the design system (#ds-cards): the whole card is one link.
// On hover the border turns red, a small square appears in the corner and the image
// brightens and zooms slightly. Put the image in the `media` slot.
// Without `href`, the card is a plain frame with no hover effect.

interface Props {
  href?: string
  /** Opens another site in a new tab. Add a screen reader mention inside the card. */
  external?: boolean
  class?: string
}

const { href, external = false, class: className, ...attrs } = Astro.props
const Tag = href ? 'a' : 'div'
---

<Tag
  {...attrs}
  href={href}
  class:list={['card', className]}
  target={href && external ? '_blank' : undefined}
  rel={href && external ? 'noopener' : undefined}
>
  {Astro.slots.has('media') && (
    <div class="media">
      <slot name="media" />
    </div>
  )}
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-white);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    transition: border-color var(--duration-base) ease-out;
  }

  a.card:hover {
    color: var(--color-ink);
  }

  /* Red square in the top-right corner */
  .card::before {
    content: '';
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    width: 12px;
    height: 12px;
    background: var(--color-primary);
    transform: scale(0);
    transform-origin: top right;
    transition: transform var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }

  /* 2 px red frame drawn inside the border, so nothing shifts */
  .card::after {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: 4;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px var(--color-primary);
    opacity: 0;
    transition: opacity var(--duration-base) ease-out;
    pointer-events: none;
  }

  a.card:hover,
  a.card:focus-visible {
    border-color: var(--color-primary);
  }

  a.card:hover::before,
  a.card:focus-visible::before {
    transform: scale(1);
  }

  a.card:hover::after,
  a.card:focus-visible::after {
    opacity: 1;
  }

  a.card:focus-visible {
    outline-offset: 4px;
  }

  .media {
    position: relative;
    overflow: hidden;
  }

  .media :global(img) {
    display: block;
    width: 100%;
    object-fit: cover;
    filter: brightness(0.95) saturate(0.97);
    transition:
      transform 0.6s var(--ease-out),
      filter 0.6s ease;
  }

  a.card:hover .media :global(img),
  a.card:focus-visible .media :global(img) {
    filter: none;
    transform: scale(1.025);
  }
</style>
