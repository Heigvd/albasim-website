---
// Illustration of the error page: the number 404 drawn with the squares of the AlbaSim logo.
// One square has fallen out of the zero and bobs on the ground, under a blinking question mark.
// With reduced motion, it stays still.

interface Props {
  /** Description for screen readers. */
  label: string
  class?: string
}

const { label, class: className, ...attrs } = Astro.props

type Fill = 'ink' | 'gradient' | 'soft' | 'outline'

// Squares of the three digits, on a 36 px grid: [x, y, fill].
const squares: [number, number, Fill][] = [
  // 4
  [34, 52, 'soft'],
  [106, 52, 'ink'],
  [34, 88, 'ink'],
  [106, 88, 'gradient'],
  [34, 124, 'ink'],
  [70, 124, 'outline'],
  [106, 124, 'ink'],
  [106, 160, 'ink'],
  [106, 196, 'ink'],
  // 0, with a square missing at the bottom right
  [178, 52, 'ink'],
  [214, 52, 'gradient'],
  [250, 52, 'ink'],
  [178, 88, 'ink'],
  [250, 88, 'ink'],
  [178, 124, 'ink'],
  [250, 124, 'ink'],
  [178, 160, 'soft'],
  [178, 196, 'ink'],
  [214, 196, 'outline'],
  [250, 196, 'ink'],
  // 4
  [322, 52, 'ink'],
  [394, 52, 'soft'],
  [322, 88, 'ink'],
  [394, 88, 'ink'],
  [322, 124, 'gradient'],
  [358, 124, 'ink'],
  [394, 124, 'ink'],
  [394, 160, 'ink'],
  [394, 196, 'outline'],
]
---

<svg
  {...attrs}
  class:list={['error-illustration', className]}
  viewBox="0 0 460 340"
  role="img"
  aria-label={label}
>
  <defs>
    <linearGradient id="error-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="stop-light"></stop>
      <stop offset="1" class="stop-primary"></stop>
    </linearGradient>
  </defs>

  <!-- Background lines: a small cube and an arc -->
  <g class="decor">
    <polygon points="436,24 422,16 408,24 408,40 422,48 436,40"></polygon>
    <path d="M422 16 L422 32 M408 40 L422 32 L436 40"></path>
    <path d="M18 300 A 150 150 0 0 1 120 160" class="arc"></path>
  </g>

  <!-- Loose squares on the ground -->
  <rect x="392" y="230" width="18" height="18" transform="rotate(-14 401 239)" class="ink"></rect>
  <rect
    x="66"
    y="262"
    width="14"
    height="14"
    transform="rotate(12 73 269)"
    class="outline thin"
  ></rect>

  <text x="265" y="183" text-anchor="middle" class="question">
    ?
  </text>

  {squares.map(([x, y, fill]) => (
    <rect x={x} y={y} width="30" height="30" class={fill} />
  ))}

  <!-- The gap left by the fallen square, and its path to the ground -->
  <rect x="250.7" y="160.7" width="28" height="28" class="gap"></rect>
  <path d="M265 196 C 280 230, 290 250, 282 274" class="trail"></path>

  <!-- Ground, shadow and the fallen square -->
  <path d="M40 322 L420 322" class="ground"></path>
  <ellipse cx="280" cy="324" rx="26" ry="3.5" class="shadow"></ellipse>
  <g class="fall">
    <rect
      x="-15"
      y="-15"
      width="30"
      height="30"
      class="gradient"
      transform="translate(280 296) rotate(22)"
    ></rect>
  </g>
</svg>

<style>
  .error-illustration {
    display: block;
    width: 100%;
    max-width: 460px;
    max-height: 60vh;
    height: auto;
    margin: 0 auto;
  }

  .decor {
    fill: none;
    stroke: var(--color-primary-soft);
    stroke-width: 1.2;
  }

  .arc {
    stroke-width: 1.4;
  }

  .gradient {
    fill: url(#error-gradient);
  }

  .soft,
  .outline {
    stroke: var(--color-ink);
    stroke-width: 1.6;
  }

  .thin {
    stroke-width: 1.4;
  }

  .gap {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.4;
    stroke-dasharray: 4 4;
    opacity: 0.55;
  }

  .trail {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.3;
    stroke-dasharray: 3 5;
    opacity: 0.45;
  }

  .ground {
    stroke: var(--color-ink);
    stroke-width: 1.4;
  }

  .shadow {
    fill: var(--color-ink);
    opacity: 0.12;
  }

  .question {
    font-size: 22px;
    font-weight: 800;
    fill: var(--color-ink);
    animation: blink 3.2s ease-in-out infinite;
  }

  .fall {
    transform-box: fill-box;
    transform-origin: center bottom;
    animation: bob 3.2s ease-in-out infinite;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 0.25;
    }

    50% {
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .question,
    .fall {
      animation: none;
    }

    .question {
      opacity: 0.5;
    }
  }
</style>
