---
// "Research approach" of a project: the text next to a diagram of the research process. Two
// inputs lead to an iterative cycle of three steps, which leads to two outputs.
import Icon from '../Icon.astro'
import SectionHeading from '../SectionHeading.astro'
import type { ProjectPage } from '../../utils/projects'

type Props = NonNullable<ProjectPage['approach']>

const { eyebrow, heading, paragraphs, inputs, cycle, outputs } = Astro.props

// The three steps of the cycle, clockwise from the top, with their colors.
const steps = [
  { x: 160, y: 58, color: 'lavender' },
  { x: 250, y: 188, color: 'peach' },
  { x: 70, y: 188, color: 'turquoise' },
].map((step, i) => ({ ...step, label: cycle.steps[i] ?? '' }))
---

<section aria-labelledby="approach-heading">
  <div class="container inner">
    <div>
      <SectionHeading eyebrow={eyebrow} title={heading} id="approach-heading" class="heading" />
      {paragraphs.map((paragraph) => (
        <p class="t-body paragraph">{paragraph}</p>
      ))}
    </div>

    <div class="process">
      <ul class="boxes">
        {inputs.map((box) => (
          <li class="box">
            <span class="t-label box-label">{box.label}</span>
            <span class="t-sub">{box.text}</span>
          </li>
        ))}
      </ul>
      <Icon name="arrow-down" width={20} height={34} class="down" />

      <div class="cycle">
        <svg viewBox="0 0 320 250" role="img" aria-label={cycle.alt} class="cycle-diagram">
          <defs>
            <marker
              id="approach-arrow"
              orient="auto"
              markerWidth="6"
              markerHeight="6"
              refX="3"
              refY="3"
            >
              <path d="M0 0 L6 3 L0 6 Z" class="arrow-head"></path>
            </marker>
          </defs>
          <g class="turns">
            <path d="M200 70 Q245 95 252 140" marker-end="url(#approach-arrow)"></path>
            <path d="M210 212 Q160 238 112 214" marker-end="url(#approach-arrow)"></path>
            <path d="M68 148 Q74 98 118 72" marker-end="url(#approach-arrow)"></path>
          </g>
          {steps.map((step) => (
            <g>
              <circle cx={step.x} cy={step.y} r="38" class={step.color} />
              <text x={step.x} y={step.y + 5} text-anchor="middle" class="step">
                {step.label}
              </text>
            </g>
          ))}
          {cycle.center.map((line, i) => (
            <text
              x="160"
              y={145 - ((cycle.center.length - 1) * 15) / 2 + i * 15}
              text-anchor="middle"
              class="center"
            >
              {line}
            </text>
          ))}
        </svg>
        <p class="t-label cycle-label">{cycle.label}</p>
        <p class="t-small cycle-text">{cycle.text}</p>
      </div>

      <Icon name="arrow-down" width={20} height={34} class="down after-cycle" />
      <ul class="boxes">
        {outputs.map((box) => (
          <li class="box">
            <span class="t-label box-label">{box.label}</span>
            <span class="t-sub">{box.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px;
    align-items: center;
    padding-block: 96px;
  }

  .heading {
    margin-bottom: 24px;
  }

  .heading :global(.eyebrow) {
    width: auto;
  }

  .paragraph {
    margin: 0 0 16px;
  }

  .paragraph:last-child {
    margin-bottom: 0;
  }

  .process {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .boxes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-block);
    background: var(--color-white);
    text-align: center;
  }

  .box-label {
    color: var(--color-primary-text);
  }

  .process :global(.down) {
    align-self: center;
    color: var(--color-ink);
  }

  .process :global(.after-cycle) {
    margin-top: 10px;
  }

  .cycle {
    padding: 18px 22px 40px;
    border: 1.5px dashed var(--color-ink);
    border-radius: 20px;
    background: var(--color-white);
    text-align: center;
  }

  .cycle-diagram {
    display: block;
    width: 78%;
    height: auto;
    margin: 0 auto;
    font-family: var(--font-sans);
  }

  .turns {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 2;
  }

  .arrow-head {
    fill: var(--color-ink);
  }

  .lavender {
    fill: var(--color-lavender-strong);
  }

  .peach {
    fill: var(--color-peach-strong);
  }

  .turquoise {
    fill: var(--color-turquoise-strong);
  }

  .step {
    fill: var(--color-ink);
    font-size: 14px;
    font-weight: 800;
  }

  .center {
    fill: var(--color-ink);
    font-size: 12px;
    font-weight: 800;
  }

  .cycle-label {
    margin: 8px 0 4px;
  }

  .cycle-text {
    margin: 0;
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .boxes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
