---
// "Overview" of a project: the text from the Markdown body of the project, next to a diagram
// or a photo.
import { Image } from 'astro:assets'
import SectionHeading from '../SectionHeading.astro'
import CommunitiesDiagram from './CommunitiesDiagram.astro'
import MethodsDiagram from './MethodsDiagram.astro'
import PathDiagram from './PathDiagram.astro'
import type { ProjectPage } from '../../utils/projects'

type Props = ProjectPage['overview']

const { eyebrow, heading, diagram, image, imageAlt } = Astro.props
---

<section aria-labelledby="overview-heading">
  <div class="container inner">
    <div>
      <SectionHeading eyebrow={eyebrow} title={heading} id="overview-heading" class="heading" />
      <div class="text t-body">
        <slot />
      </div>
    </div>
    {diagram?.type === 'methods' && <MethodsDiagram {...diagram} />}
    {diagram?.type === 'path' && <PathDiagram {...diagram} />}
    {diagram?.type === 'communities' && <CommunitiesDiagram {...diagram} />}
    {!diagram && image && (
      <Image
        src={image}
        alt={imageAlt ?? ''}
        widths={[600, 1200]}
        sizes="(max-width: 820px) 100vw, 584px"
        class="photo"
      />
    )}
  </div>
</section>

<style>
  .inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px;
    align-items: center;
    padding-block: 88px 110px;
  }

  .heading {
    margin-bottom: 32px;
  }

  .heading :global(.eyebrow) {
    width: auto;
  }

  .text :global(p) {
    margin: 0 0 16px;
  }

  .text :global(h3) {
    margin: 36px 0 6px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  /* A subheading is 36 px below the paragraph before it. */
  .text :global(p:has(+ h3)) {
    margin-bottom: 0;
  }

  .text :global(ol) {
    margin: 0;
    padding-left: 22px;
  }

  .text :global(li + li) {
    margin-top: 10px;
  }

  .photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0 96px;
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
