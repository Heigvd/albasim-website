---
// Illustration of the Emergency Triage project: a triage nurse at a desk with patient tags,
// between two sources of distraction, a loudspeaker and a ringing phone, under a heart rate
// signal. The tags and the distractions rise under the mouse pointer. The animation is shared:
// see src/scripts/illustrations.ts.
import './illustration.css'

interface Props {
  /** Description for screen readers. */
  label: string
  /** Words written in the illustration (none here). */
  labels?: Record<string, string>
  class?: string
}

const { label, labels: _labels, class: className, ...attrs } = Astro.props
---

<svg
  {...attrs}
  class:list={['project-illustration', className]}
  viewBox="0 0 420 300"
  role="img"
  aria-label={label}
  data-illustration
  data-lift-radius="63"
>
  <defs>
    <linearGradient id="triage-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="stop-light"></stop>
      <stop offset="0.5" class="stop-mid"></stop>
      <stop offset="1" class="stop-primary"></stop>
    </linearGradient>
  </defs>

  <polygon points="405,22 392,14.5 379,22 379,37 392,44.5 405,37" class="soft-line"></polygon>

  <!-- Nurse, with a cross -->
  <circle cx="210" cy="104" r="22" class="ink"></circle>
  <path d="M170 196 C 170 156, 190 136, 210 136 C 230 136, 250 156, 250 196 Z" class="ink"></path>
  <rect x="204" y="152" width="12" height="4" rx="1" fill="url(#triage-gradient)"></rect>
  <rect x="208" y="148" width="4" height="12" rx="1" fill="url(#triage-gradient)"></rect>

  <!-- Desk -->
  <rect x="100" y="196" width="220" height="14" rx="4" class="ink"></rect>
  <rect x="118" y="210" width="10" height="60" class="ink"></rect>
  <rect x="292" y="210" width="10" height="60" class="ink"></rect>

  <!-- Patient tags, by priority -->
  <g class="lift">
    <rect x="136" y="214" width="34" height="22" rx="4" class="primary"></rect>
    <rect x="176" y="214" width="34" height="22" rx="4" class="peach-strong"></rect>
    <rect x="216" y="214" width="34" height="22" rx="4" class="turquoise"></rect>
    <rect x="256" y="214" width="34" height="22" rx="4" class="outline thin"></rect>
  </g>

  <!-- Loudspeaker -->
  <g class="lift">
    <rect x="40" y="58" width="58" height="58" rx="12" class="outline"></rect>
    <path d="M58 78 L64 78 L64 96 L58 96 Z M64 78 L76 70 L76 104 L64 96" class="ink"></path>
    <path d="M82 78 Q 88 87 82 96 M86 72 Q 96 87 86 102" class="stroke waves"></path>
  </g>

  <!-- Ringing phone -->
  <g class="lift">
    <rect x="322" y="58" width="58" height="58" rx="12" class="ink"></rect>
    <rect x="340" y="70" width="22" height="36" rx="4" class="phone"></rect>
    <circle cx="358" cy="70" r="7" class="primary"></circle>
  </g>
  <path d="M98 87 L160 104 M322 87 L260 104" class="distraction"></path>

  <!-- Heart rate signal -->
  <g transform="translate(210,40)">
    <circle r="22" fill="url(#triage-gradient)"></circle>
    <path d="M-14 0 L-6 0 L-2 -9 L3 9 L7 0 L14 0" class="stroke signal"></path>
  </g>
</svg>

<style>
  .outline.thin {
    stroke-width: 1.2;
  }

  .waves {
    stroke-width: 1.6;
  }

  .phone {
    fill: none;
    stroke: var(--color-white);
    stroke-width: 1.6;
  }

  .distraction {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.2;
    stroke-dasharray: 4 4;
  }

  .signal {
    stroke-width: 2;
  }
</style>

<script>
  import '../../../scripts/illustrations'
</script>
