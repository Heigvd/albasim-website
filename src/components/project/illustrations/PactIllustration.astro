---
// Illustration of the PACT project: a laptop showing code brackets and programming blocks, and a
// character on a path of blocks. The blocks rise under the mouse pointer. The animation is
// shared: see src/scripts/illustrations.ts.
import './illustration.css'

interface Props {
  /** Description for screen readers. */
  label: string
  /** Words written in the illustration (none here). */
  labels?: Record<string, string>
  class?: string
}

const { label, labels: _labels, class: className, ...attrs } = Astro.props

// Path of blocks under the laptop; the third one is dark and the last one red.
const path = [40, 90, 140, 190, 240, 290, 340]
---

<svg
  {...attrs}
  class:list={['project-illustration', className]}
  viewBox="0 0 420 300"
  role="img"
  aria-label={label}
  data-illustration
  data-lift-radius="63"
>
  <defs>
    <linearGradient id="pact-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="stop-light"></stop>
      <stop offset="0.5" class="stop-mid"></stop>
      <stop offset="1" class="stop-primary"></stop>
    </linearGradient>
  </defs>

  <polygon points="405,22 392,14.5 379,22 379,37 392,44.5 405,37" class="soft-line"></polygon>

  <!-- Laptop -->
  <rect x="100" y="70" width="220" height="140" rx="10" class="ink"></rect>
  <rect x="114" y="84" width="192" height="112" rx="4" class="white"></rect>
  <path d="M80 210 L340 210 L326 228 L94 228 Z" class="ink"></path>
  <path d="M148 120 L134 140 L148 160 M272 120 L286 140 L272 160" class="stroke brackets"></path>

  <!-- Programming blocks on the screen -->
  <g class="lift">
    <rect x="164" y="104" width="40" height="22" rx="4" class="lavender-strong"></rect>
    <rect x="210" y="104" width="46" height="22" rx="4" class="primary"></rect>
    <rect x="164" y="132" width="60" height="22" rx="4" class="turquoise"></rect>
    <rect x="176" y="160" width="58" height="22" rx="4" class="peach-strong"></rect>
  </g>

  <!-- Path of blocks, with the character on the third one -->
  <g class="lift">
    {path.map((x, i) => (
      <rect
        x={x}
        y="248"
        width="40"
        height="28"
        rx="6"
        class={i === 2 ? 'ink' : i === path.length - 1 ? 'primary' : 'outline'}
      />
    ))}
  </g>
  <circle cx="160" cy="262" r="8" fill="url(#pact-gradient)"></circle>

  <!-- Code badge -->
  <g transform="translate(360,92)">
    <circle r="24" fill="url(#pact-gradient)"></circle>
    <path d="M-8 -6 L-14 0 L-8 6 M8 -6 L14 0 L8 6 M3 -9 L-3 9" class="stroke badge"></path>
  </g>
</svg>

<style>
  .brackets {
    stroke-width: 3;
  }

  .badge {
    stroke-width: 2;
  }
</style>

<script>
  import '../../../scripts/illustrations'
</script>
