---
// Illustration of the "Serious games in higher education" project: two students around a game
// board on a table, linked to a university building, above a project timeline. The game pieces
// and the building rise under the mouse pointer. The animation is shared: see
// src/scripts/illustrations.ts.
import './illustration.css'

interface Props {
  /** Description for screen readers. */
  label: string
  /** Words written in the illustration (none here). */
  labels?: Record<string, string>
  class?: string
}

const { label, labels: _labels, class: className, ...attrs } = Astro.props
---

<svg
  {...attrs}
  class:list={['project-illustration', className]}
  viewBox="0 0 420 300"
  role="img"
  aria-label={label}
  data-illustration
  data-lift-radius="63"
>
  <defs>
    <linearGradient id="sghe-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="stop-light"></stop>
      <stop offset="0.5" class="stop-mid"></stop>
      <stop offset="1" class="stop-primary"></stop>
    </linearGradient>
  </defs>

  <polygon points="405,22 392,14.5 379,22 379,37 392,44.5 405,37" class="soft-line"></polygon>

  <!-- Game board, with its pieces and track -->
  <rect x="96" y="150" width="228" height="96" rx="14" class="outline"></rect>
  <g class="lift">
    <rect x="118" y="168" width="40" height="26" rx="5" class="ink"></rect>
    <rect x="166" y="168" width="40" height="26" rx="5" class="lavender-strong"></rect>
    <rect x="214" y="168" width="40" height="26" rx="5" class="outline thin"></rect>
    <rect x="262" y="168" width="40" height="26" rx="5" class="peach-strong"></rect>
  </g>
  <path d="M118 220 L302 220" class="dashed"></path>
  <circle cx="210" cy="220" r="12" fill="url(#sghe-gradient)"></circle>

  <!-- Two students -->
  <circle cx="62" cy="128" r="18" class="ink"></circle>
  <path d="M30 214 C 30 176, 46 158, 62 158 C 78 158, 94 176, 94 214 Z" class="ink"></path>
  <circle cx="358" cy="128" r="18" class="outline"></circle>
  <path d="M326 214 C 326 176, 342 158, 358 158 C 374 158, 390 176, 390 214 Z" class="light"></path>

  <!-- University building -->
  <g class="lift">
    <rect x="150" y="38" width="120" height="78" rx="8" class="ink"></rect>
    <path d="M140 44 L210 14 L280 44 Z" class="ink"></path>
    <rect x="166" y="60" width="16" height="40" rx="2" class="white" opacity="0.85"></rect>
    <rect x="202" y="60" width="16" height="40" rx="2" class="white" opacity="0.85"></rect>
    <rect x="238" y="60" width="16" height="40" rx="2" class="white" opacity="0.85"></rect>
  </g>
  <path d="M210 116 L210 150" class="dashed short"></path>

  <!-- Project timeline -->
  <rect x="40" y="262" width="340" height="8" rx="4" class="line-fill"></rect>
  <rect x="40" y="262" width="210" height="8" rx="4" fill="url(#sghe-gradient)"></rect>
</svg>

<style>
  .outline.thin {
    stroke-width: 1.2;
  }

  .dashed.short {
    stroke-dasharray: 4 4;
  }
</style>

<script>
  import '../../../scripts/illustrations'
</script>
