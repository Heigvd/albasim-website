---
// "Outcomes" of a project, on a light pink band: two or three cards with an icon, a title, a
// text and links, e.g. to the games born from the project.
import ArrowLink from '../ArrowLink.astro'
import Icon from '../Icon.astro'
import SectionHeading from '../SectionHeading.astro'
import type { Lang } from '../../i18n/ui'
import { projectLinkTarget, type ProjectPage } from '../../utils/projects'

type Props = ProjectPage['outcomes'] & { lang: Lang }

const { eyebrow, heading, cards, lang } = Astro.props
---

<section class="outcomes" aria-labelledby="outcomes-heading">
  <div class="container inner">
    <SectionHeading eyebrow={eyebrow} title={heading} id="outcomes-heading" class="heading" />
    <ul class="cards" style={{ '--columns': Math.min(cards.length, 3) }}>
      {cards.map((card) => (
        <li class="card">
          <Icon name={card.icon} width={36} strokeWidth={1.6} class="icon" />
          <h3 class="t-card title">{card.title}</h3>
          <p class="t-body text">{card.text}</p>
          {card.links.length > 0 && (
            <div class="links">
              {card.links.map((link) => {
                const { href, external } = projectLinkTarget(link, lang)
                return (
                  <ArrowLink
                    href={href}
                    kind={external ? 'external' : 'page'}
                    lang={lang}
                    class="t-link"
                  >
                    {link.label}
                  </ArrowLink>
                )
              })}
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .outcomes {
    background: var(--color-tint);
  }

  .inner {
    padding-block: 96px;
  }

  .heading {
    margin-bottom: 56px;
  }

  .heading :global(.title) {
    max-width: 820px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-block);
    background: var(--color-white);
  }

  .card :global(.icon) {
    height: 40px;
    color: var(--color-primary-text);
  }

  .title,
  .text {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: auto;
    padding-top: 8px;
  }

  @media (max-width: 820px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
