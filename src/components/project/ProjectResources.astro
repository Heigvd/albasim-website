---
// "Resources" of a project: links to other sites, then its publications, as cards linking to
// the publisher's site, and an optional note.
import type { CollectionEntry } from 'astro:content'
import ArrowLink from '../ArrowLink.astro'
import PublicationCard from '../PublicationCard.astro'
import SectionHeading from '../SectionHeading.astro'
import type { Lang } from '../../i18n/ui'
import type { ProjectPage } from '../../utils/projects'
import { publicationCardProps } from '../../utils/publications'

type Props = Omit<ProjectPage['resources'], 'publications'> & {
  publications: CollectionEntry<'publications'>[]
  lang: Lang
}

const { eyebrow, heading, links, publications, note, lang } = Astro.props
---

<section aria-labelledby="resources-heading">
  <div class="container inner">
    <SectionHeading eyebrow={eyebrow} title={heading} id="resources-heading" class="heading" />
    {links && (
      <div class="links-block">
        <h3 class="t-sub links-heading">{links.heading}</h3>
        <div class="links">
          {links.items.map((link) => (
            <ArrowLink href={link.url} kind="external" lang={lang} class="t-link">
              {link.label}
            </ArrowLink>
          ))}
        </div>
      </div>
    )}
    <ul class="grid">
      {publications.map((entry) => (
        <li>
          <PublicationCard {...publicationCardProps(entry)} lang={lang} />
        </li>
      ))}
    </ul>
    {note && <p class="t-small note">{note}</p>}
  </div>
</section>

<style>
  .inner {
    padding-block: 48px 96px;
  }

  .heading {
    margin-bottom: 40px;
  }

  .heading :global(.title) {
    max-width: 820px;
  }

  .links-block {
    margin-bottom: 48px;
  }

  .links-heading {
    margin: 0 0 16px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
  }

  .note {
    margin: 24px 0 0;
    color: var(--color-text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: flex;
  }

  .grid > li > :global(*) {
    flex: 1;
  }

  @media (max-width: 820px) {
    .links-block {
      margin-bottom: 48px;
    }

    .links-heading {
      margin: 0 0 16px;
    }

    .links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 40px;
    }

    .note {
      margin: 24px 0 0;
      color: var(--color-text-muted);
    }

    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
