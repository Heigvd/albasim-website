---
// Diagram of the "Overview" section: the current situation and its limits, leading to the
// project and its steps, leading to the goal. Each text is on one line: SVG text does not wrap,
// so they must stay short.
import type { ProjectPage } from '../../utils/projects'

type Props = Extract<NonNullable<ProjectPage['overview']['diagram']>, { type: 'path' }>

const {
  alt,
  currentLabel,
  current,
  limitsLabel,
  limits,
  projectLabel,
  projectTitle,
  steps,
  goalLabel,
  goal,
} = Astro.props

// Vertical positions, from the top: each part grows with its number of lines.
const currentHeight = 90 + limits.length * 30
const projectTop = 34 + currentHeight + 48
const projectHeight = 110 + steps.length * 32
const goalTop = projectTop + projectHeight + 48
const height = goalTop + 70
---

<svg viewBox={`0 0 520 ${height}`} role="img" aria-label={alt} class="diagram">
  <defs>
    <marker id="path-arrow" orient="auto" markerWidth="8" markerHeight="8" refX="6" refY="4">
      <path d="M0 0 L8 4 L0 8 Z" class="arrow-head"></path>
    </marker>
  </defs>

  <text x="260" y="16" text-anchor="middle" class="label">
    {currentLabel}
  </text>
  <rect x="60" y="34" width="400" height={currentHeight} rx="12" class="box"></rect>
  <text x="84" y="72" class="current">
    {current}
  </text>
  <text x="84" y="104" class="label">
    {limitsLabel}
  </text>
  {limits.map((limit, i) => (
    <g>
      <circle cx="89" cy={134 + i * 30} r="3.5" class="bullet" />
      <text x="102" y={140 + i * 30} class="limit">
        {limit}
      </text>
    </g>
  ))}

  <path
    d={`M260 ${34 + currentHeight} L260 ${projectTop - 10}`}
    class="link"
    marker-end="url(#path-arrow)"
  ></path>

  <rect x="20" y={projectTop} width="480" height={projectHeight} rx="12" class="project"></rect>
  <text x="260" y={projectTop + 34} text-anchor="middle" class="label">
    {projectLabel}
  </text>
  <text x="260" y={projectTop + 66} text-anchor="middle" class="project-title">
    {projectTitle}
  </text>
  <line x1="60" y1={projectTop + 90} x2="460" y2={projectTop + 90} class="rule"></line>
  {steps.map((step, i) => (
    <g>
      <circle cx="72" cy={projectTop + 116 + i * 32} r="11" class="bullet" />
      <text x="72" y={projectTop + 121 + i * 32} text-anchor="middle" class="number">
        {i + 1}
      </text>
      <text x="94" y={projectTop + 122 + i * 32} class="step">
        {step}
      </text>
    </g>
  ))}

  <path
    d={`M260 ${projectTop + projectHeight} L260 ${goalTop - 10}`}
    class="link"
    marker-end="url(#path-arrow)"
  ></path>

  <rect x="60" y={goalTop} width="400" height="68" rx="12" class="goal"></rect>
  <text x="260" y={goalTop + 28} text-anchor="middle" class="label on-dark">
    {goalLabel}
  </text>
  <text x="260" y={goalTop + 54} text-anchor="middle" class="goal-text">
    {goal}
  </text>
</svg>

<style>
  .diagram {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }

  .label {
    fill: var(--color-primary-text);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1.6px;
  }

  .label.on-dark {
    fill: var(--color-white);
  }

  .box {
    fill: var(--color-white);
    stroke: var(--color-line);
    stroke-width: 1.2;
  }

  .current {
    fill: var(--color-ink);
    font-size: 19px;
    font-weight: 700;
  }

  .limit {
    fill: var(--color-text-muted);
    font-size: 18px;
  }

  .bullet {
    fill: var(--color-primary);
  }

  .link {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.5;
  }

  .arrow-head {
    fill: var(--color-ink);
  }

  .project {
    fill: var(--color-tint);
  }

  .project-title {
    fill: var(--color-ink);
    font-size: 21px;
    font-weight: 700;
  }

  .rule {
    stroke: var(--color-line);
  }

  .number {
    fill: var(--color-white);
    font-size: 13px;
    font-weight: 800;
  }

  .step {
    fill: var(--color-ink);
    font-size: 18px;
    font-weight: 600;
  }

  .goal {
    fill: var(--color-ink);
  }

  .goal-text {
    fill: var(--color-white);
    font-size: 17px;
    font-weight: 600;
  }
</style>
