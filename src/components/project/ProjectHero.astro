---
// Top of a project page: a breadcrumb back to the research projects, the title, the
// introduction, optional buttons to the games born from the project, and the project's
// illustration in the `illustration` slot.
import Button from '../Button.astro'
import { gamePath, localizedPath, useTranslations, type Lang } from '../../i18n/ui'

interface Props {
  title: string
  heading: string
  lead: string
  intro: string[]
  buttons: { label: string; game: string }[]
  lang: Lang
}

const { title, heading, lead, intro, buttons, lang } = Astro.props
const t = useTranslations(lang)
const research = localizedPath('research', lang)
---

<section class="hero">
  <nav class="container breadcrumb t-breadcrumb" aria-label={t('breadcrumb.label')}>
    <ol>
      <li>
        <a href={research}>{t('nav.research')}</a>
      </li>
      <li>
        <a href={`${research}#projects`}>{t('project.allProjects')}</a>
      </li>
      <li>
        <span aria-current="page">{title}</span>
      </li>
    </ol>
  </nav>
  <div class="container inner split">
    <div>
      <h1 class="t-h1">{heading}</h1>
      <p class="lead t-lead">{lead}</p>
      {intro.map((paragraph) => (
        <p class="intro t-body">{paragraph}</p>
      ))}
      {buttons.length > 0 && (
        <div class="buttons">
          {buttons.map((button) => (
            <Button href={gamePath(button.game, lang)} variant="secondary" tone="dark">
              {button.label}
            </Button>
          ))}
        </div>
      )}
    </div>
    <slot name="illustration" />
  </div>
</section>

<style>
  .hero {
    background: var(--gradient-hero);
  }

  .breadcrumb {
    padding-top: var(--space-7);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Slash between the links */
  .breadcrumb li + li::before {
    content: '/' / '';
    margin-right: 10px;
  }

  .breadcrumb a {
    text-decoration: underline;
  }

  .inner {
    gap: var(--space-14);
    align-items: center;
    min-height: 460px;
    padding-block: var(--space-8) var(--section-space-m);
  }

  h1 {
    margin: 0 0 var(--space-6);
    text-wrap: balance;
  }

  .lead {
    margin: 0 0 var(--space-3);
    font-weight: 500;
  }

  .intro {
    margin: 0 0 var(--space-1);
  }

  .intro:last-of-type {
    margin-bottom: var(--space-8);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  @media (max-width: 820px) {
    .inner {
      min-height: 0;
    }
  }
</style>
