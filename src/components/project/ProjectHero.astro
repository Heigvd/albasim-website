---
// Top of a project page: a breadcrumb back to the research projects, the title, the
// introduction, an optional button to the game born from the project, and the project's
// illustration in the `illustration` slot.
import Button from '../Button.astro'
import { gamePath, localizedPath, useTranslations, type Lang } from '../../i18n/ui'

interface Props {
  title: string
  heading: string
  lead: string
  intro: string[]
  button?: { label: string; game: string }
  lang: Lang
}

const { title, heading, lead, intro, button, lang } = Astro.props
const t = useTranslations(lang)
const research = localizedPath('research', lang)
---

<section class="hero">
  <nav class="container breadcrumb" aria-label={t('breadcrumb.label')}>
    <ol>
      <li>
        <a href={research}>{t('nav.research')}</a>
      </li>
      <li>
        <a href={`${research}#projects`}>{t('project.allProjects')}</a>
      </li>
      <li>
        <span aria-current="page">{title}</span>
      </li>
    </ol>
  </nav>
  <div class="container inner">
    <div>
      <h1 class="t-h1">{heading}</h1>
      <p class="lead t-lead">{lead}</p>
      {intro.map((paragraph) => (
        <p class="intro t-body">{paragraph}</p>
      ))}
      {button && (
        <Button href={gamePath(button.game, lang)} variant="secondary" tone="dark" class="button">
          {button.label}
        </Button>
      )}
    </div>
    <slot name="illustration" />
  </div>
</section>

<style>
  .hero {
    background: var(--gradient-hero);
  }

  .breadcrumb {
    padding-top: 28px;
    font-size: 14px;
    line-height: 21px;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Slash between the links */
  .breadcrumb li + li::before {
    content: '/' / '';
    margin-right: 10px;
  }

  .breadcrumb a {
    text-decoration: underline;
  }

  .inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    align-items: center;
    min-height: 460px;
    padding-block: 31px 64px;
  }

  h1 {
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .lead {
    margin: 0 0 12px;
    font-weight: 500;
  }

  .intro {
    margin: 0 0 4px;
  }

  .intro:last-of-type {
    margin-bottom: 32px;
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
  }
</style>
