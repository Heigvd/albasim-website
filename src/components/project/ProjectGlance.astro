---
// "Project at a glance": on a dark band, four white cards with the focus, the period, the
// funding and the people of the project (main applicants, leads or partners).
import SectionHeading from '../SectionHeading.astro'
import type { ProjectPage } from '../../utils/projects'

type Props = ProjectPage['glance']

const { eyebrow, heading, focus, period, funding, people } = Astro.props
---

<section class="glance" aria-labelledby="glance-heading">
  <div class="container inner">
    <SectionHeading
      eyebrow={eyebrow}
      title={heading}
      id="glance-heading"
      inverted
      class="heading"
    />
    <div class="cards">
      <dl class="card">
        <dt class="label t-label">{focus.label}</dt>
        <dd class="pills">
          {focus.items.map((item) => (
            <span class="pill">{item}</span>
          ))}
        </dd>
      </dl>
      <dl class="card">
        <dt class="label t-label">{period.label}</dt>
        <dd class="t-value">{period.value}</dd>
      </dl>
      <dl class="card">
        <dt class="label t-label">{funding.label}</dt>
        <dd class="t-value">{funding.value}</dd>
        {funding.detail && <dd class="t-small">{funding.detail}</dd>}
      </dl>
      <dl class="card">
        {people.map((group) => (
          <>
            <dt class="label t-label">{group.label}</dt>
            {group.people.map((person) => (
              <dd class="person">
                <span class="t-value">{person.name}</span>
                {person.affiliation && <span class="t-small">{person.affiliation}</span>}
              </dd>
            ))}
          </>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .glance {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .inner {
    padding-block: 72px;
  }

  .heading {
    margin-bottom: 40px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    color: var(--color-ink);
  }

  .card {
    padding: 30px 26px 32px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-white);
  }

  .label {
    margin-bottom: 14px;
    color: var(--color-primary-text);
  }

  dd {
    margin: 0;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-tint);
    font-size: 15px;
    line-height: 1.3;
  }

  /* A second group of people, e.g. the co-lead after the lead */
  .person + .label {
    margin-top: 22px;
  }

  .person {
    display: flex;
    flex-direction: column;
  }

  /* Names with an affiliation are further apart than names alone. */
  .person + .person {
    margin-top: 10px;
  }

  .person:has(.t-small) + .person {
    margin-top: 14px;
  }

  @media (max-width: 820px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
