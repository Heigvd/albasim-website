---
// "Key findings" of a project, on a dark band: one card per finding (up to three per row), with
// its source and a link to the paper when there is one.
import ArrowLink from '../ArrowLink.astro'
import SectionHeading from '../SectionHeading.astro'
import { useTranslations, type Lang } from '../../i18n/ui'
import { withItalics } from '../../utils/text'

interface Props {
  eyebrow: string
  heading: string
  items: { text: string; source: string; url?: string }[]
  lang: Lang
}

const { eyebrow, heading, items, lang } = Astro.props
const t = useTranslations(lang)
---

<section class="findings" aria-labelledby="findings-heading">
  <div class="container inner">
    <SectionHeading
      eyebrow={eyebrow}
      title={heading}
      id="findings-heading"
      inverted
      class="heading"
    />
    <ul
      class:list={['cards', { single: items.length === 1 }]}
      style={{ '--columns': Math.min(items.length, 3) }}
    >
      {items.map((item) => (
        <li class="card">
          <p class="t-body text">{item.text}</p>
          <p class="t-meta source" set:html={withItalics(item.source)} />
          {item.url && (
            <ArrowLink href={item.url} kind="external" lang={lang} class="t-link link">
              {t('project.readPaper')}
            </ArrowLink>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .findings {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .inner {
    padding-block: 72px;
  }

  .heading {
    margin-bottom: 40px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A single finding keeps a readable line length. */
  .single {
    max-width: 820px;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 30px 26px 32px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-white);
    color: var(--color-ink);
  }

  .text {
    margin: 0 0 14px;
  }

  .source {
    margin: 0;
    color: var(--color-text-muted);
  }

  .link {
    margin-top: 14px;
  }

  @media (max-width: 820px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
