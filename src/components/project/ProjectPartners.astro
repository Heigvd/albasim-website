---
// "Partners" of a project: who carried it out, with their logos, and the acknowledgements to
// the funders, whose logos link to their websites. It may end with a call for participants.
import { Image } from 'astro:assets'
import Button from '../Button.astro'
import SectionHeading from '../SectionHeading.astro'
import { localizedPath, useTranslations, type Lang } from '../../i18n/ui'
import type { ProjectPage } from '../../utils/projects'
import { withLinks } from '../../utils/text'

type Props = ProjectPage['partners'] & { lang: Lang }

const { eyebrow, heading, paragraphs, logos, acknowledgements, getInvolved, lang } = Astro.props
const t = useTranslations(lang)
---

<section aria-labelledby="partners-heading">
  <div class="container inner">
    <SectionHeading eyebrow={eyebrow} title={heading} id="partners-heading" class="heading" />
    <div class="columns">
      <div>
        {paragraphs.map((paragraph) => (
          <p class="t-body paragraph" set:html={withLinks(paragraph, t('link.newTab'))} />
        ))}
        <ul class="logos">
          {logos.map((item) => (
            <li class="logo-box">
              <Image
                src={item.logo}
                alt={item.name}
                height={item.height}
                densities={[1, 2]}
                class="logo"
                style={{ height: `${item.height}px` }}
              />
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="t-h3 acknowledgements">{acknowledgements.heading}</h3>
        <p class="t-body thanks">{acknowledgements.text}</p>
        <ul class="logos">
          {acknowledgements.funders.map((item) => (
            <li class="funder-box">
              <a href={item.url} target="_blank" rel="noopener" class="funder">
                <Image
                  src={item.logo}
                  alt={item.name}
                  height={item.height}
                  densities={[1, 2]}
                  class="logo"
                  style={{ height: `${item.height}px` }}
                />
                <span class="sr-only">{t('link.newTab')}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    {getInvolved && (
      <div class="involved">
        <div>
          <span class="involved-rule" aria-hidden="true"></span>
          <h2 class="t-h2">{getInvolved.heading}</h2>
        </div>
        <div>
          <p class="t-lead involved-text">{getInvolved.text}</p>
          <Button href={localizedPath('contact', lang)} variant="on-tint">
            {getInvolved.button}
          </Button>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .inner {
    padding-block: 96px 48px;
  }

  .heading {
    margin-bottom: 32px;
  }

  .heading :global(.title) {
    max-width: 820px;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px;
    align-items: start;
  }

  .paragraph {
    margin: 0 0 16px;
  }

  .paragraph :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .paragraph:last-of-type {
    margin-bottom: 32px;
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logo-box,
  .funder-box {
    display: flex;
    align-items: center;
    max-width: 100%;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
  }

  .logo-box {
    height: 64px;
    padding: 0 22px;
  }

  .funder-box {
    padding: 18px 22px;
  }

  .funder {
    display: block;
  }

  .logo {
    display: block;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .acknowledgements {
    margin: 0 0 8px;
  }

  .thanks {
    margin: 0 0 40px;
  }

  /* Call for participants */
  .involved {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    align-items: start;
    margin-top: 72px;
    padding: 56px 48px 60px;
    border-radius: 14px;
    background: var(--color-tint);
  }

  .involved-rule {
    display: block;
    width: 140px;
    height: 3px;
    margin: 7px 0 22px;
    background: var(--color-ink);
  }

  .involved-text {
    margin: 0 0 28px;
  }

  @media (max-width: 820px) {
    .columns,
    .involved {
      grid-template-columns: minmax(0, 1fr);
    }

    .involved {
      gap: 24px;
      padding: 40px 24px;
    }
  }
</style>
