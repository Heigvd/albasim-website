---
// One member of the team: portrait, position, name, degree and contact details, then the
// presentation from the Markdown body. The head of the team (`lead`) has a larger portrait and
// title.
import { Image } from 'astro:assets'
import { render, type CollectionEntry } from 'astro:content'
import { useTranslations, type Lang } from '../../i18n/ui'

interface Props {
  person: CollectionEntry<'people'>
  lang: Lang
}

const { person, lang } = Astro.props
const t = useTranslations(lang)
const { Content } = await render(person)
const data = person.data
const size = data.lead ? 140 : 100
const hasContact = data.email || data.phone || data.links.length > 0
---

<li class:list={['member', { lead: data.lead }]}>
  <Image
    src={data.portrait}
    alt={data.portraitAlt}
    width={size}
    height={size}
    densities={[1, 2]}
    class="portrait"
  />
  <div class="identity">
    <p class="role t-label">{data.role}</p>
    <h3 class:list={['name', data.lead ? 't-h2' : 't-h3']}>{data.name}</h3>
    <p class="degree t-small">{data.degree}</p>
    {hasContact && (
      <ul class="contact t-small">
        {data.email && (
          <li>
            <a href={`mailto:${data.email}`}>{data.email}</a>
          </li>
        )}
        {data.phone && (
          <li>
            <a href={`tel:${data.phone.replaceAll(' ', '')}`}>{data.phone}</a>
          </li>
        )}
        {data.links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener">
              {link.label}
              <span class="sr-only"> {t('link.newTab')}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
  <div class="bio t-body">
    <Content />
  </div>
</li>

<style>
  .member {
    display: grid;
    grid-template-columns: 140px minmax(0, 4fr) minmax(0, 6fr);
    gap: 40px;
    align-items: start;
    padding: 32px 0;
    border-top: 1px solid var(--color-line);
  }

  .member.lead {
    padding: 12px 0 40px;
    border-top: none;
  }

  .portrait {
    display: block;
    border-radius: 50%;
    object-fit: cover;
  }

  .role,
  .name,
  .degree {
    margin: 0 0 6px;
  }

  .role {
    color: var(--color-primary-text);
  }

  .degree {
    margin-bottom: 10px;
    color: var(--color-text-muted);
  }

  .lead .role,
  .lead .name {
    margin-bottom: 8px;
  }

  .lead .degree {
    margin-bottom: 16px;
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact a:hover {
    color: var(--color-primary-text);
  }

  .bio :global(p) {
    margin: 0;
  }

  .bio :global(p + p) {
    margin-top: 16px;
  }

  @media (max-width: 820px) {
    .member {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
