---
// The current members of the team, the head first, then the former members in a section that
// opens on demand.
import type { CollectionEntry } from 'astro:content'
import Icon from '../Icon.astro'
import SectionHeading from '../SectionHeading.astro'
import TeamMember from './TeamMember.astro'
import type { Lang } from '../../i18n/ui'

interface Props {
  heading: string
  people: CollectionEntry<'people'>[]
  former: { heading: string; list: { name: string; role: string }[] }
  lang: Lang
}

const { heading, people, former, lang } = Astro.props
const sorted = [...people].sort((a, b) => a.data.order - b.data.order)
---

<section aria-labelledby="members-heading">
  <div class="container inner">
    <SectionHeading eyebrow={heading} id="members-heading" class="heading" />
    <ul class="members">
      {sorted.map((person) => (
        <TeamMember person={person} lang={lang} />
      ))}
    </ul>

    <details class="former">
      <summary class="t-sub">
        {former.heading}
        <Icon name="chevron" width={16} strokeWidth={2} class="chevron" />
      </summary>
      <ul class="former-list">
        {former.list.map((member) => (
          <li>
            <span class="t-value">{member.name}</span>
            <span class="former-role"> · {member.role}</span>
          </li>
        ))}
      </ul>
    </details>
  </div>
</section>

<style>
  .inner {
    padding-block: 32px 72px;
  }

  .heading {
    margin-bottom: 28px;
  }

  .members {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Former members */
  .former {
    margin-top: 40px;
  }

  .former summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 16px 0;
    border-block: 1px solid var(--color-line);
    list-style: none;
    cursor: pointer;
  }

  .former summary::-webkit-details-marker {
    display: none;
  }

  .former summary:hover {
    color: var(--color-primary-text);
  }

  .former[open] summary {
    border-bottom-color: transparent;
  }

  .chevron {
    flex: 0 0 auto;
    transition: transform var(--duration-fast) ease;
  }

  .former[open] .chevron {
    transform: rotate(180deg);
  }

  .former-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 56px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .former-list li {
    padding: 14px 0;
  }

  .former-list li:nth-child(n + 3) {
    border-top: 1px solid var(--color-line);
  }

  .former-role {
    color: var(--color-text-muted);
  }

  @media (max-width: 820px) {
    .former-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .former-list li:nth-child(2) {
      border-top: 1px solid var(--color-line);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }
</style>
