---
// Presentation of the Wegas platform: two lists of benefits and an illustration of its three
// modules (edit, play, monitor), with a link to the Wegas part of the research page.
import ArrowLink from '../ArrowLink.astro'
import SectionHeading from '../SectionHeading.astro'
import { localizedPath, useTranslations, type Lang } from '../../i18n/ui'

interface Props {
  eyebrow: string
  title: string
  text: string
  columns: { title: string; items: string[] }[]
  modules: { name: string; users: string[] }[]
  link: string
  lang: Lang
}

const { eyebrow, title, text, columns, modules, link, lang } = Astro.props
const t = useTranslations(lang)
const label = `${t('wegas.modules')} ${modules.map((m) => m.name).join(', ')}`
// Horizontal center of each module window in the illustration.
const centers = [52, 160, 268]
---

<section class="wegas" aria-labelledby="wegas-heading">
  <div class="container inner">
    <SectionHeading eyebrow={eyebrow} title={title} id="wegas-heading" class="heading" />
    <p class="lead t-lead">{text}</p>

    <div class="grid">
      {columns.map((column) => (
        <div>
          <h3 class="column-title t-card">{column.title}</h3>
          <ul class="list">
            {column.items.map((item) => (
              <li class="t-body">{item}</li>
            ))}
          </ul>
        </div>
      ))}

      <svg class="modules" viewBox="0 0 320 230" role="img" aria-label={label}>
        {centers.map((cx) => (
          <g>
            <rect x={cx - 48} y="20" width="96" height="120" rx="8" class="window" />
            <rect x={cx - 48} y="20" width="96" height="18" rx="8" class="ink" />
            <rect x={cx - 48} y="30" width="96" height="8" class="ink" />
            <circle cx={cx - 38} cy="29" r="2.5" class="white" />
            <circle cx={cx - 30} cy="29" r="2.5" class="white" />
          </g>
        ))}

        <!-- Edit: blocks of content -->
        <rect x="14" y="48" width="76" height="16" rx="3" class="lavender" />
        <rect x="14" y="70" width="52" height="16" rx="3" class="lavender" />
        <rect x="14" y="92" width="64" height="16" rx="3" class="lavender" />
        <rect x="14" y="114" width="40" height="16" rx="3" class="lavender" />

        <!-- Play: a game board and two answer buttons -->
        <rect x="122" y="48" width="76" height="52" rx="4" class="peach" />
        <rect x="134" y="62" width="12" height="12" class="ink" />
        <rect x="152" y="70" width="12" height="12" class="red" />
        <rect x="170" y="58" width="12" height="12" class="window thin" />
        <rect x="122" y="108" width="34" height="22" rx="4" class="ink" />
        <rect x="164" y="108" width="34" height="22" rx="4" class="window thin" />

        <!-- Monitor: a bar chart -->
        <rect x="232" y="96" width="12" height="34" class="turquoise" />
        <rect x="250" y="76" width="12" height="54" class="turquoise" />
        <rect x="268" y="86" width="12" height="44" class="turquoise" />
        <rect x="286" y="60" width="12" height="70" class="red" />
        <rect x="230" y="48" width="44" height="6" rx="3" class="line" />

        {modules.map((module, i) => (
          <g text-anchor="middle">
            <text x={centers[i]} y="166" class="name">
              {module.name}
            </text>
            {module.users.map((user, j) => (
              <text x={centers[i]} y={186 + j * 16} class="user">
                {user}
              </text>
            ))}
          </g>
        ))}
      </svg>
    </div>

    <ArrowLink href={`${localizedPath('research', lang)}#wegas`} class="more">
      {link}
    </ArrowLink>
  </div>
</section>

<style>
  .inner {
    padding-block: var(--section-space) 100px;
  }

  .heading :global(.title) {
    max-width: 66%;
    margin-bottom: 20px;
  }

  .lead {
    max-width: 66%;
    margin: 0 0 48px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    align-items: start;
  }

  .column-title {
    margin: 0 0 12px;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .list li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-line);
  }

  /* Red square bullet */
  .list li::before {
    content: '';
    flex: 0 0 10px;
    height: 10px;
    background: var(--color-primary);
    transform: translateY(-1px);
  }

  .modules {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 240px;
    margin: 0 auto;
    font-family: var(--font-sans);
  }

  .window {
    fill: var(--color-white);
    stroke: var(--color-ink);
    stroke-width: 1.5;
  }

  .window.thin {
    stroke-width: 1;
  }

  .ink {
    fill: var(--color-ink);
  }

  .white {
    fill: var(--color-white);
  }

  .red {
    fill: var(--color-primary);
  }

  .lavender {
    fill: var(--color-lavender);
  }

  .peach {
    fill: var(--color-peach);
  }

  .turquoise {
    fill: var(--color-turquoise);
  }

  .line {
    fill: var(--color-line);
  }

  .name {
    font-size: 15px;
    font-weight: 800;
    fill: var(--color-ink);
  }

  .user {
    font-size: 12px;
    fill: var(--color-text-muted);
  }

  .more {
    margin-top: 40px;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .modules {
      max-height: 300px;
    }
  }
</style>
