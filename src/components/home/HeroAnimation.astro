---
// Decorative animation of the home hero, drawn on a canvas: a staircase of squares that a red
// lift climbs once when the hero comes into view, plus a turning hexagon and two bobbing nodes.
// Squares rise under the mouse pointer. With reduced motion, only the final image is drawn.
// It carries no information, so it is hidden from screen readers.

interface Props {
  class?: string
}

const { class: className, ...attrs } = Astro.props
---

<canvas {...attrs} class:list={['hero-animation', className]} aria-hidden="true"></canvas>

<style>
  .hero-animation {
    display: block;
    width: 100%;
    aspect-ratio: 300 / 240;
  }
</style>

<script>
  // Drawing space of the original design, scaled to the canvas size.
  const WIDTH = 300
  const HEIGHT = 240
  /** Length of the climbing animation, in seconds. */
  const END = 1.4

  // Staircase squares: x, y and fill (f: ink, g: red gradient, o: outline).
  const SQUARES = (
    [
      [60, 190, 'f'],
      [90, 190, 'f'],
      [120, 190, 'f'],
      [60, 160, 'f'],
      [90, 160, 'f'],
      [120, 160, 'g'],
      [60, 130, 'f'],
      [120, 130, 'o'],
      [150, 130, 'g'],
      [90, 100, 'o'],
      [150, 100, 'f'],
      [180, 70, 'o'],
      [210, 40, 'g'],
    ] as const
  ).map(([x, y, fill]) => ({ x, y, fill, diagonal: x - y }))
  const TILTED = 10
  const SIZE = 26

  interface Colors {
    primary: string
    light: string
    mid: string
    soft: string
    ink: string
    white: string
  }

  interface Point {
    x: number
    y: number
  }

  function readColors(el: Element): Colors {
    const style = getComputedStyle(el)
    const get = (name: string) => style.getPropertyValue(name).trim()
    return {
      primary: get('--color-primary'),
      light: get('--color-primary-light'),
      mid: get('--color-primary-mid'),
      soft: get('--color-primary-soft'),
      ink: get('--color-ink'),
      white: get('--color-white'),
    }
  }

  function draw(ctx: CanvasRenderingContext2D, T: number, c: Colors, mouse: Point | null) {
    ctx.clearRect(0, 0, WIDTH, HEIGHT)

    // Hexagon, slowly turning
    ctx.save()
    ctx.translate(240, 190)
    ctx.rotate(T * 0.12)
    ctx.strokeStyle = c.soft
    ctx.lineWidth = 0.8
    ctx.beginPath()
    for (let i = 0; i < 6; i++) {
      const a = Math.PI / 6 + (i * Math.PI) / 3
      if (i) ctx.lineTo(32 * Math.cos(a), 32 * Math.sin(a))
      else ctx.moveTo(32 * Math.cos(a), 32 * Math.sin(a))
    }
    ctx.closePath()
    for (let i = 0; i < 6; i++) {
      const a = Math.PI / 6 + (i * Math.PI) / 3
      ctx.moveTo(0, 0)
      ctx.lineTo(32 * Math.cos(a), 32 * Math.sin(a))
    }
    ctx.stroke()
    ctx.restore()

    // Breathing curve
    ctx.strokeStyle = c.soft
    ctx.lineWidth = 1
    ctx.beginPath()
    ctx.moveTo(30, 210)
    ctx.quadraticCurveTo(30 + 6 * Math.sin(T * 0.5), 120 + 8 * Math.sin(T * 0.7), 120, 130)
    ctx.stroke()

    // Connector lines of the bobbing nodes
    const bob1 = 3 * Math.sin(T * 1.1)
    const bob2 = 3 * Math.sin(T * 1.1 + 1.8)
    ctx.strokeStyle = c.ink
    ctx.beginPath()
    ctx.moveTo(223, 53)
    ctx.lineTo(280, 20 + bob1)
    ctx.moveTo(193, 53)
    ctx.lineTo(193, 20 + bob2)
    ctx.stroke()

    // Staircase: a lift travels up the stairs, the pointer lifts squares too
    const wave = -25 + T * 170
    SQUARES.forEach((q, i) => {
      const inBase = q.x < 150
      let lift = inBase || T >= END ? 0 : Math.max(0, 1 - Math.abs(q.diagonal - wave) / 45)
      if (mouse) lift = Math.max(lift, 1 - Math.hypot(q.x + 13 - mouse.x, q.y + 13 - mouse.y) / 42)

      if (lift > 0.01) {
        ctx.globalAlpha = lift
        ctx.fillStyle = c.primary
        ctx.fillRect(q.x + 3 * lift, q.y + 3 * lift, SIZE, SIZE)
        ctx.globalAlpha = 1
      }

      const X = q.x - 3 * lift
      const Y = q.y - 3 * lift
      const tilted = i === TILTED
      if (tilted) {
        ctx.save()
        ctx.translate(X + SIZE / 2, Y + SIZE / 2)
        ctx.rotate(0.24)
        ctx.translate(-(X + SIZE / 2), -(Y + SIZE / 2))
      }

      if (q.fill === 'f') {
        ctx.fillStyle = c.ink
        ctx.fillRect(X, Y, SIZE, SIZE)
      } else if (q.fill === 'g') {
        const angle = Math.PI / 4 + 1.2 * Math.sin(T * 0.5 + q.diagonal * 0.02)
        const cx = X + 13
        const cy = Y + 13
        const ex = 18 * Math.cos(angle)
        const ey = 18 * Math.sin(angle)
        const gradient = ctx.createLinearGradient(cx - ex, cy - ey, cx + ex, cy + ey)
        gradient.addColorStop(0, c.light)
        gradient.addColorStop(0.5, c.mid)
        gradient.addColorStop(1, c.primary)
        ctx.fillStyle = gradient
        ctx.fillRect(X, Y, SIZE, SIZE)
      } else {
        ctx.fillStyle = c.white
        ctx.fillRect(X, Y, SIZE, SIZE)
        ctx.globalAlpha = 0.22 * (0.5 + 0.5 * Math.sin(T * 1.3 + q.diagonal * 0.03))
        ctx.fillStyle = c.primary
        ctx.fillRect(X, Y, SIZE, SIZE)
        ctx.globalAlpha = 1
        ctx.strokeStyle = c.ink
        ctx.lineWidth = 1
        ctx.strokeRect(X, Y, SIZE, SIZE)
      }

      if (tilted) ctx.restore()
    })

    // Bobbing nodes
    ctx.lineWidth = 1.2
    ctx.fillStyle = c.white
    ctx.strokeStyle = c.ink
    ctx.beginPath()
    ctx.arc(280, 20 + bob1, 6, 0, Math.PI * 2)
    ctx.fill()
    ctx.stroke()
    ctx.fillStyle = c.ink
    ctx.beginPath()
    ctx.arc(193, 20 + bob2, 6, 0, Math.PI * 2)
    ctx.fill()
  }

  function setUp(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')
    if (!ctx) return

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
    const colors = readColors(canvas)
    let T = reduced.matches ? END : 0
    let mouse: Point | null = null
    let frame = 0
    let last = 0

    const render = () => {
      const width = canvas.clientWidth
      if (!width) return
      const ratio = window.devicePixelRatio || 1
      const pixels = Math.round(width * ratio)
      if (canvas.width !== pixels) {
        canvas.width = pixels
        canvas.height = Math.round(((width * HEIGHT) / WIDTH) * ratio)
      }
      const k = (width / WIDTH) * ratio
      ctx.setTransform(k, 0, 0, k, 0, 0)
      draw(ctx, T, colors, mouse)
    }

    const request = () => {
      if (!frame) frame = requestAnimationFrame(tick)
    }

    // Runs only while the lift climbs or the pointer moves, then stops.
    function tick(now: number) {
      frame = 0
      if (T < END) {
        const dt = last ? Math.min(0.05, (now - last) / 1000) : 0
        last = now
        T = Math.min(END, T + dt)
        if (T < END) request()
      }
      render()
    }

    const play = () => {
      if (reduced.matches) return
      T = 0
      last = 0
      request()
    }

    // The lift climbs once, the first time most of the hero is visible.
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect()
          play()
        }
      },
      { threshold: 0.4 },
    )
    observer.observe(canvas)

    canvas.addEventListener('pointermove', (event) => {
      const k = WIDTH / canvas.clientWidth
      mouse = { x: event.offsetX * k, y: event.offsetY * k }
      request()
    })
    canvas.addEventListener('pointerleave', () => {
      mouse = null
      request()
    })
    reduced.addEventListener('change', () => {
      T = END
      request()
    })
    new ResizeObserver(request).observe(canvas)
    render()
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.hero-animation').forEach(setUp)
</script>
