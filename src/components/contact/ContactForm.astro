---
// The contact form. For now it only has the look of the design: it sends nothing, and its
// button does nothing.
import Button from '../Button.astro'

interface Props {
  labels: { name: string; email: string; subject: string; message: string; send: string }
}

const { labels } = Astro.props

const fields = [
  { id: 'contact-name', label: labels.name, type: 'text', autocomplete: 'name', required: true },
  {
    id: 'contact-email',
    label: labels.email,
    type: 'email',
    autocomplete: 'email',
    required: true,
  },
  { id: 'contact-subject', label: labels.subject, type: 'text', required: false },
] as const
---

<form class="form">
  {fields.map((field) => (
    <div>
      <label class="label t-value" for={field.id}>
        {field.label}
        {field.required && (
          <span class="required" aria-hidden="true">
            *
          </span>
        )}
      </label>
      <input
        id={field.id}
        name={field.id}
        type={field.type}
        autocomplete={'autocomplete' in field ? field.autocomplete : undefined}
        required={field.required}
        class="field t-body"
      />
    </div>
  ))}
  <div>
    <label class="label t-value" for="contact-message">
      {labels.message}
      <span class="required" aria-hidden="true">
        *
      </span>
    </label>
    <textarea
      id="contact-message"
      name="contact-message"
      rows="7"
      required
      class="field t-body"
    ></textarea>
  </div>
  <div>
    <Button>{labels.send}</Button>
  </div>
</form>

<style>
  .form {
    display: grid;
    gap: 22px;
  }

  .label {
    display: block;
    margin-bottom: 8px;
  }

  .required {
    margin-left: 0.25em;
    color: var(--color-primary-text);
  }

  .field {
    display: block;
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--color-separator);
    border-radius: var(--radius-card);
    background: var(--color-white);
    color: var(--color-ink);
    font: inherit;
  }

  .field:focus {
    border-color: transparent;
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }

  textarea.field {
    min-height: 180px;
    resize: vertical;
  }
</style>
