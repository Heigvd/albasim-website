---
// The contact form. It posts to public/contact.php, which emails the message.
// - With JavaScript, the script below sends it in the background and shows the result under the
//   button.
// - Without JavaScript, the browser posts it and contact.php redirects to the thank-you or error
//   page.
// The hidden `website` field is a honeypot: people never see it, spam bots fill it in, and
// contact.php then drops the message.
import Button from '../Button.astro'
import { useTranslations, type Lang } from '../../i18n/ui'

interface Props {
  lang: Lang
  labels: {
    name: string
    email: string
    subject: string
    message: string
    send: string
    sending: string
    sent: string
    invalid: string
    failed: string
  }
}

const { lang, labels } = Astro.props
const t = useTranslations(lang)

// The maximum lengths are checked again by contact.php: keep them in sync.
const fields = [
  {
    id: 'contact-name',
    name: 'name',
    label: labels.name,
    type: 'text',
    autocomplete: 'name',
    maxlength: 100,
    required: true,
  },
  {
    id: 'contact-email',
    name: 'email',
    label: labels.email,
    type: 'email',
    autocomplete: 'email',
    maxlength: 254,
    required: true,
  },
  {
    id: 'contact-subject',
    name: 'subject',
    label: labels.subject,
    type: 'text',
    maxlength: 200,
    required: false,
  },
] as const
---

<form class="form" action="/contact.php" method="post" data-contact-form>
  <input type="hidden" name="lang" value={lang} />
  {fields.map((field) => (
    <div>
      <label class="label t-value" for={field.id}>
        {field.label}
        {field.required && (
          <span class="required" aria-hidden="true">
            *
          </span>
        )}
      </label>
      <input
        id={field.id}
        name={field.name}
        type={field.type}
        autocomplete={'autocomplete' in field ? field.autocomplete : undefined}
        maxlength={field.maxlength}
        required={field.required}
        class="field t-body"
      />
    </div>
  ))}
  <div>
    <label class="label t-value" for="contact-message">
      {labels.message}
      <span class="required" aria-hidden="true">
        *
      </span>
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="7"
      maxlength="5000"
      required
      class="field t-body"
    ></textarea>
  </div>
  <div class="honeypot" aria-hidden="true">
    <label for="contact-website">{t('contact.honeypot')}</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="actions">
    <Button type="submit">{labels.send}</Button>
    <p
      class="status t-small"
      role="status"
      data-sending={labels.sending}
      data-sent={labels.sent}
      data-invalid={labels.invalid}
      data-failed={labels.failed}
    ></p>
  </div>
</form>

<script>
  type State = 'sending' | 'sent' | 'invalid' | 'failed'

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')
    const status = form.querySelector<HTMLElement>('.status')
    if (!button || !status) continue

    const show = (state: State) => {
      status.dataset.state = state
      status.textContent = status.dataset[state] ?? ''
    }

    // The browser has already checked the required fields and the email when this runs.
    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      // `aria-disabled` instead of `disabled`, so the button keeps the keyboard focus.
      if (button.getAttribute('aria-disabled') === 'true') return
      button.setAttribute('aria-disabled', 'true')
      show('sending')

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
        const result: { ok?: boolean; error?: string } | null = await response
          .json()
          .catch(() => null)
        if (response.ok && result?.ok) {
          form.reset()
          show('sent')
        } else {
          show(result?.error === 'invalid' ? 'invalid' : 'failed')
        }
      } catch {
        show('failed')
      } finally {
        button.removeAttribute('aria-disabled')
      }
    })
  }
</script>

<style>
  .form {
    display: grid;
    gap: var(--space-6);
  }

  .label {
    display: block;
    margin-bottom: var(--space-2);
  }

  .required {
    margin-left: 0.25em;
    color: var(--color-primary-text);
  }

  .field {
    display: block;
    width: 100%;
    padding: 14px var(--space-4);
    border: 1px solid var(--color-separator);
    border-radius: var(--radius-card);
    background: var(--color-white);
    color: var(--color-ink);
    font: inherit;
  }

  .field:focus {
    border-color: transparent;
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }

  textarea.field {
    min-height: 180px;
    resize: vertical;
  }

  /* Out of sight and out of reach for people; bots still find it in the HTML. */
  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .actions {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .actions :global(.button[aria-disabled='true']) {
    opacity: 0.6;
    cursor: progress;
  }

  .status {
    margin: 0;
  }

  .status:empty {
    display: none;
  }

  .status[data-state='sending'] {
    color: var(--color-text-muted);
  }

  .status[data-state='sent'],
  .status[data-state='invalid'],
  .status[data-state='failed'] {
    padding: 12px 16px;
    border-left: 4px solid;
    border-radius: var(--radius-card);
    color: var(--color-ink);
  }

  .status[data-state='sent'] {
    border-color: var(--color-sage-strong);
    background: var(--color-sage);
  }

  .status[data-state='invalid'],
  .status[data-state='failed'] {
    border-color: var(--color-primary);
    background: var(--color-tint);
  }
</style>
