---
// Illustration of the contact page hero: a speech bubble and an envelope with pixel squares
// rising from it. When it comes into view, the dots of the bubble appear, the address lines
// write themselves and the squares bob; afterwards, the dots type while the pointer is over the
// illustration. With reduced motion, it stays still. The animation is shared: see
// src/scripts/illustrations.ts.

interface Props {
  /** Description for screen readers. */
  label: string
  class?: string
}

const { label, class: className, ...attrs } = Astro.props

// Dots in the speech bubble: [x, fill, delay in s].
const dots = [
  [88, 'white', 0.1],
  [110, 'primary', 0.3],
  [132, 'white', 0.5],
] as const
// Address lines on the envelope, written from the bottom up: [x2, y, delay in s].
const lines = [
  [196, 176, 1],
  [186, 186, 0.7],
] as const
// Squares rising from the envelope, in the order they bob: [x, y, size, fill].
const squares = [
  [250, 86, 16, 'primary'],
  [270.5, 68.5, 13, 'ink'],
  [240, 58, 16, 'outline'],
  [276, 40, 16, 'primary'],
  [252.5, 30.5, 13, 'ink'],
] as const
---

<svg
  {...attrs}
  class:list={['contact-illustration', className]}
  viewBox="0 0 320 230"
  role="img"
  aria-label={label}
  data-illustration
  data-duration="1400"
>
  <!-- Speech bubble and its dots -->
  <path
    d="M76 70 H164 Q180 70 180 86 V134 Q180 150 164 150 H104 L82 172 L86 150 H76 Q60 150 60 134 V86 Q60 70 76 70 Z"
    class="ink"
  ></path>
  {dots.map(([x, fill, delay]) => (
    <rect
      x={x}
      y="104"
      width="12"
      height="12"
      class:list={['dot', 'rise', fill]}
      style={`animation-delay: ${delay}s`}
    />
  ))}

  <!-- Envelope -->
  <rect x="150" y="112" width="120" height="84" rx="4" class="outline envelope"></rect>
  <polyline points="150,112 210,156 270,112" class="flap"></polyline>
  <g class="text-lines">
    {lines.map(([x2, y, delay]) => (
      <line
        x1="166"
        y1={y}
        x2={x2}
        y2={y}
        pathLength="1"
        class="write"
        style={`animation-delay: ${delay}s`}
      />
    ))}
  </g>

  <!-- Squares rising from the envelope -->
  {squares.map(([x, y, size, fill], i) => (
    <rect
      x={x}
      y={y}
      width={size}
      height={size}
      class:list={['square', 'wiggle', fill]}
      style={`animation-delay: ${(i * 0.12).toFixed(2)}s`}
    />
  ))}
</svg>

<style>
  .contact-illustration {
    display: block;
    width: 100%;
    max-width: 460px;
    height: auto;
    aspect-ratio: 4 / 3;
    margin-left: auto;
  }

  .ink {
    fill: var(--color-ink);
  }

  .white {
    fill: var(--color-white);
  }

  .primary {
    fill: var(--color-primary);
  }

  .outline {
    fill: var(--color-white);
    stroke: var(--color-ink);
  }

  .envelope {
    stroke-width: 1.5;
  }

  .flap {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .text-lines {
    stroke: var(--color-primary-soft);
    stroke-width: 3;
  }

  /* Once the illustration has played, the dots type while the pointer is over it, one after
     the other thanks to their animation delays. */
  .dot {
    transform-box: fill-box;
  }

  .contact-illustration[data-played]:not([data-playing]):hover .dot {
    animation: typing 1.1s ease-in-out infinite;
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
    }

    30% {
      transform: translateY(-7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-illustration[data-played]:not([data-playing]):hover .dot {
      animation: none;
    }
  }
</style>

<script>
  import '../../scripts/illustrations'
</script>
