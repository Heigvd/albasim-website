---
// Wegas as the lab's research infrastructure: text, highlights and a link to the source code,
// next to a photo and a small diagram of the research cycle (prototype, test, analyze).
// The home page links to this section through its `wegas` id.
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Button from '../Button.astro'
import Icon from '../Icon.astro'
import SectionHeading from '../SectionHeading.astro'
import { useTranslations, type Lang } from '../../i18n/ui'

interface Props {
  eyebrow: string
  title: string
  text: string
  highlights: string[]
  button: string
  image: ImageMetadata
  imageAlt: string
  steps: string[]
  lang: Lang
}

const { eyebrow, title, text, highlights, button, image, imageAlt, steps, lang } = Astro.props
const t = useTranslations(lang)
const stepsLabel = `${t('wegas.researchSteps')} ${steps.join(', ')}`
// Left edge of each step box in the diagram.
const boxes = [1, 118, 235]
---

<section class="wegas" id="wegas" aria-labelledby="wegas-heading">
  <div class="container inner">
    <div>
      <SectionHeading eyebrow={eyebrow} title={title} id="wegas-heading" class="heading" />
      <p class="t-body text">{text}</p>
      <ul class="highlights">
        {highlights.map((item) => (
          <li class="t-body">
            <strong>{item}</strong>
          </li>
        ))}
      </ul>
      <Button href="https://github.com/Heigvd/Wegas" variant="secondary" tone="dark" external>
        <Icon name="github" width={20} strokeWidth={1.6} />
        {button}
        <span class="sr-only">{t('link.newTab')}</span>
      </Button>
    </div>

    <div class="media">
      <Image
        src={image}
        alt={imageAlt}
        widths={[600, 1200]}
        sizes="(max-width: 820px) 100vw, 592px"
        class="photo"
      />
      <svg class="cycle" viewBox="0 0 320 40" role="img" aria-label={stepsLabel}>
        <defs>
          <marker
            id="wegas-arrow"
            orient="auto"
            markerWidth="7"
            markerHeight="7"
            refX="5"
            refY="3.5"
          >
            <path d="M0 0 L7 3.5 L0 7 Z" class="arrow-head"></path>
          </marker>
        </defs>
        {boxes.map((x, i) => (
          <g>
            <rect x={x} y="4" width="84" height="32" rx="8" class="box" />
            <text x={x + 42} y="23" text-anchor="middle" class="label">
              {steps[i]}
            </text>
            {i < boxes.length - 1 && (
              <path
                d={`M${x + 89} 20 L${x + 110} 20`}
                class="link"
                marker-end="url(#wegas-arrow)"
              />
            )}
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    align-items: stretch;
    padding-block: var(--section-space) 100px;
  }

  .heading :global(.eyebrow) {
    width: auto;
  }

  .heading :global(.title) {
    margin: 32px 0 24px;
  }

  .text {
    margin: 0;
  }

  .highlights {
    margin: 28px 0 32px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .highlights li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-line);
  }

  /* Red square bullet */
  .highlights li::before {
    content: '';
    flex: 0 0 10px;
    height: 10px;
    background: var(--color-primary);
    transform: translateY(-1px);
  }

  .media {
    display: flex;
    flex-direction: column;
  }

  .photo {
    display: block;
    flex: 1 1 0;
    width: 100%;
    min-height: 260px;
    object-fit: cover;
    border-radius: 0 96px;
  }

  .cycle {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 20px;
    font-family: var(--font-sans);
  }

  .box {
    fill: var(--color-peach);
  }

  .label {
    fill: var(--color-ink);
    font-size: 8px;
    font-weight: 700;
  }

  .link {
    stroke: var(--color-ink);
    stroke-width: 1.2;
  }

  .arrow-head {
    fill: var(--color-ink);
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
