---
// Top of the research page: the title, the introduction from the Markdown body and the
// illustration, on the pink halo background.
import ResearchIllustration from './ResearchIllustration.astro'

interface Props {
  heading: string
  illustrationAlt: string
}

const { heading, illustrationAlt } = Astro.props
---

<section class="hero">
  <div class="container inner">
    <div>
      <h1 class="t-h1">{heading}</h1>
      <div class="intro t-lead">
        <slot />
      </div>
    </div>
    <ResearchIllustration label={illustrationAlt} />
  </div>
</section>

<style>
  .hero {
    background: var(--gradient-hero);
  }

  .inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    align-items: center;
    padding-block: 80px 64px;
  }

  h1 {
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .intro {
    max-width: 560px;
    text-wrap: pretty;
  }

  .intro :global(p) {
    margin: 0;
  }

  .intro :global(p + p) {
    padding-top: 16px;
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
