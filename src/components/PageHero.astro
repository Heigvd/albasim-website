---
// Top of an inner page (research, publications, team): the title, the introduction from the
// Markdown body and an illustration, on the pink halo background. Put the introduction in the
// default slot, the illustration in the `illustration` slot and, if needed, a link under the
// introduction in the `after` slot.

interface Props {
  heading: string
}

const { heading } = Astro.props
---

<section class="hero">
  <div class="container inner">
    <div>
      <h1 class="t-h1">{heading}</h1>
      <div class="intro t-lead">
        <slot />
      </div>
      {Astro.slots.has('after') && (
        <div class="after">
          <slot name="after" />
        </div>
      )}
    </div>
    <slot name="illustration" />
  </div>
</section>

<style>
  .hero {
    background: var(--gradient-hero);
  }

  .inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    align-items: center;
    padding-block: 80px 64px;
  }

  h1 {
    margin: 0 0 24px;
    text-wrap: balance;
  }

  .intro {
    max-width: 560px;
    text-wrap: pretty;
  }

  .intro :global(p) {
    margin: 0;
  }

  .intro :global(p + p) {
    padding-top: 16px;
  }

  .after {
    margin-top: 28px;
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
