---
// Opening statement of a game page: a title on the left, two short paragraphs on the right.
import type { GamePage } from '../../utils/games'

type Props = GamePage['intro']

const { heading, paragraphs } = Astro.props
---

<section aria-labelledby="intro-heading">
  <div class="container inner">
    <h2 id="intro-heading" class="t-h2 heading">
      {heading}
    </h2>
    <div>
      {paragraphs.map((paragraph) => (
        <p class="t-lead paragraph">{paragraph}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px;
    align-items: start;
    padding-block: 96px 64px;
  }

  .heading {
    margin: 0;
  }

  .paragraph {
    margin: 0;
  }

  .paragraph + .paragraph {
    margin-top: 6px;
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 72px;
    }
  }
</style>
