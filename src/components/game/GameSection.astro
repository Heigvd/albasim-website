---
// A text section of a game page, e.g. "For teachers": an eyebrow above a heading on the left and
// paragraphs on the right, with an optional link to the research project the game comes from.
import ArrowLink from '../ArrowLink.astro'
import { projectPath, type Lang } from '../../i18n/ui'
import type { GamePage } from '../../utils/games'

type Props = NonNullable<GamePage['sections']>[number] & { id: string; lang: Lang }

const { eyebrow, heading, paragraphs, link, id, lang } = Astro.props
---

<section class="text-section" aria-labelledby={id}>
  <div class="container inner">
    <p class="t-eyebrow eyebrow">{eyebrow}</p>
    <div class="columns">
      <h2 id={id} class="t-h2 heading">
        {heading}
      </h2>
      <div>
        {paragraphs.map((paragraph) => (
          <p class="t-body text">{paragraph}</p>
        ))}
        {link && <ArrowLink href={projectPath(link.project, lang)}>{link.label}</ArrowLink>}
      </div>
    </div>
  </div>
</section>

<style>
  .inner {
    padding-block: 96px;
  }

  .text-section + .text-section .inner {
    padding-top: 0;
  }

  /* Same look as the eyebrow of SectionHeading, above a title that sits in the first column */
  .eyebrow {
    width: 50%;
    margin: 0 0 28px;
    padding-top: 14px;
    border-top: 3px solid var(--color-primary-text);
    color: var(--color-primary-text);
    text-transform: uppercase;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px;
    align-items: start;
  }

  .heading {
    margin: 0;
  }

  .text {
    margin: 0 0 16px;
  }

  .text:last-of-type {
    margin-bottom: 24px;
  }

  .text:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 820px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
