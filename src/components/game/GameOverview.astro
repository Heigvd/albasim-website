---
// "The game": a photo next to what players do, then the phases of a game session as a
// timeline, horizontal on wide screens and vertical on small ones.
import { Image } from 'astro:assets'
import type { GamePage } from '../../utils/games'

type Props = GamePage['game']

const { eyebrow, heading, paragraphs, image, imageAlt, phases } = Astro.props
---

<section aria-labelledby="game-heading">
  <div class="container inner">
    <p class="t-eyebrow eyebrow">{eyebrow}</p>
    <div class="columns">
      <Image
        src={image}
        alt={imageAlt}
        widths={[600, 1200]}
        sizes="(max-width: 820px) 100vw, 584px"
        class="photo"
      />
      <div>
        <h2 id="game-heading" class="t-h2 heading">
          {heading}
        </h2>
        {paragraphs.map((paragraph) => (
          <p class="t-body text">{paragraph}</p>
        ))}
      </div>
    </div>
    {phases && (
      <ol class="phases" aria-label={phases.label}>
        {phases.items.map((item, i) => (
          <li>
            <span class="dot" aria-hidden="true">
              {i + 1}
            </span>
            <span class="phase">
              <span class="sr-only">{phases.phase.replace('{n}', String(i + 1))} </span>
              {item}
            </span>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
  .inner {
    padding-block: 32px 64px;
  }

  /* Same look as the eyebrow of SectionHeading, above a title that sits in the second column */
  .eyebrow {
    width: 50%;
    margin: 0 0 28px;
    padding-top: 14px;
    border-top: 3px solid var(--color-primary-text);
    color: var(--color-primary-text);
    text-transform: uppercase;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px;
    align-items: center;
  }

  .photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0 96px;
  }

  .heading {
    margin: 0 0 20px;
  }

  .text {
    margin: 0;
  }

  .text + .text {
    margin-top: 16px;
  }

  /* Timeline: a red line runs from one dot to the next. */
  .phases {
    position: relative;
    display: flex;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .phases li {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    padding-right: 24px;
  }

  .phases li:last-child {
    flex: 0 0 auto;
    padding-right: 0;
  }

  .phases li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 21px;
    left: 23px;
    width: 100%;
    height: 4px;
    background: var(--color-primary);
  }

  .dot {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 0 0 8px var(--color-tint);
    color: var(--color-white);
    font-size: 19px;
    font-weight: 800;
  }

  .phase {
    display: block;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 680px) {
    .phases {
      flex-direction: column;
      gap: 40px;
    }

    .phases::before {
      content: '';
      position: absolute;
      top: 12px;
      bottom: 12px;
      left: 21px;
      width: 4px;
      background: var(--color-primary);
    }

    .phases li,
    .phases li:last-child {
      flex: none;
      min-height: 46px;
      padding: 12px 0 0 70px;
    }

    .phases li:not(:last-child)::after {
      display: none;
    }

    .dot {
      position: absolute;
      top: 0;
      left: 0;
      margin: 0;
    }
  }
</style>
