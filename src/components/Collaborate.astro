---
// Call to action at the bottom of most pages, on a red band, with a button to
// the contact page.
import Button from './Button.astro'
import { localizedPath, type Lang } from '../i18n/ui'

interface Props {
  title: string
  text: string
  button: string
  lang: Lang
}

const { title, text, button, lang } = Astro.props
---

<section class="collaborate">
  <div class="container inner">
    <h2 class="title t-h2">{title}</h2>
    <div>
      <p class="text t-lead">{text}</p>
      <Button href={localizedPath('contact', lang)} variant="on-accent" arrow>
        {button}
      </Button>
    </div>
  </div>
</section>

<style>
  .collaborate {
    background: var(--color-accent-block);
    color: var(--color-white);
  }

  .inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    align-items: start;
    padding-block: 88px;
  }

  /* Short white rule above the title */
  .title {
    margin: 0;
  }

  .title::before {
    content: '';
    display: block;
    width: 140px;
    height: 3px;
    margin: 7px 0 22px;
    background: var(--color-white);
  }

  .text {
    margin: 0 0 28px;
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
