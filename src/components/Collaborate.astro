---
// Call to action at the bottom of most pages, on a red band, with a button to
// the contact page. With `play`, a white button to play a game online comes first and the
// contact button becomes an outline one.
import Button from './Button.astro'
import { localizedPath, useTranslations, type Lang } from '../i18n/ui'

interface Props {
  title: string
  text: string
  button: string
  /** Link to play a game online, opened in a new tab. */
  play?: { label: string; url: string }
  lang: Lang
}

const { title, text, button, play, lang } = Astro.props
const t = useTranslations(lang)
---

<section class="collaborate">
  <div class="container inner">
    <h2 class="title t-h2">{title}</h2>
    <div>
      <p class="text t-lead">{text}</p>
      <div class="buttons">
        {play && (
          <Button href={play.url} variant="on-accent" external arrow>
            {play.label}
            <span class="sr-only">{t('link.newTab')}</span>
          </Button>
        )}
        <Button
          href={localizedPath('contact', lang)}
          variant={play ? 'secondary' : 'on-accent'}
          arrow
        >
          {button}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .collaborate {
    background: var(--color-accent-block);
    color: var(--color-white);
  }

  .inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    align-items: start;
    padding-block: 88px;
  }

  /* Short white rule above the title */
  .title {
    margin: 0;
  }

  .title::before {
    content: '';
    display: block;
    width: 140px;
    height: 3px;
    margin: 7px 0 22px;
    background: var(--color-white);
  }

  .text {
    margin: 0 0 28px;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
